---
// A quiet numbers moment: key facts as large type, hairline-divided.
// No icons, no cards — the same restraint as the rest of the site.
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<div class="stat-band fade-up">
  {items.map((item) => (
    <div class="stat-band__item">
      <p class="stat-band__value">{item.value}</p>
      <p class="stat-band__label">{item.label}</p>
    </div>
  ))}
</div>

<style>
  .stat-band {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-3) var(--space-4);
  }
  .stat-band__item {
    padding-left: var(--space-3);
    border-left: 1px solid var(--tortora-densa);
  }
  .stat-band__item:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .stat-band__value {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1;
    color: var(--ink);
    margin: 0 0 0.6rem;
    text-wrap: balance;
  }
  .stat-band__label {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--clay);
    max-width: 22ch;
    margin: 0;
  }
  @media (max-width: 640px) {
    .stat-band {
      grid-template-columns: 1fr 1fr;
    }
    .stat-band__item {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--tortora-densa);
      padding-top: 1rem;
    }
    .stat-band__item:nth-child(-n + 2) {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
