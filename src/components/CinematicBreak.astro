---
// A full-bleed "breath" between editorial pairs — same photographic grade
// and scrim language as Hero.astro, just shorter and mid-page. The slow
// drift only starts once the section is actually in view (gated by the
// same .is-visible class the site-wide fade-up observer already toggles),
// so nothing animates off-screen.
import Pic from './Pic.astro';

interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<section class="cinematic fade-up">
  <Pic
    src={src}
    alt={alt}
    width={1600}
    height={1067}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    class="cinematic__img"
  />
  <div class="cinematic__scrim" aria-hidden="true"></div>
  {caption && <p class="cinematic__caption">{caption}</p>}
</section>

<style>
  .cinematic {
    position: relative;
    height: min(70svh, 46rem);
    min-height: 22rem;
    overflow: hidden;
  }
  .cinematic :global(.cinematic__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: cinematic-drift 24s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  .cinematic.is-visible :global(.cinematic__img) {
    animation-play-state: running;
  }
  @keyframes cinematic-drift {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.14) translate3d(-1.5%, -1.5%, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cinematic :global(.cinematic__img) {
      animation: none;
    }
  }
  .cinematic__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(51 41 26 / 0.5) 0%, rgb(51 41 26 / 0.05) 45%, transparent 65%);
  }
  .cinematic__caption {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(1.5rem, 6vh, 3rem);
    margin: 0;
    text-align: center;
    padding-inline: clamp(1.25rem, 6vw, 5rem);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    letter-spacing: 0.02em;
    text-wrap: balance;
  }
</style>
