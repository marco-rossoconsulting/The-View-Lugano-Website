---
import { dict, p, type Locale } from '../lib/i18n';
import { SITE, egumaUrl } from '../lib/site';
import Waterline from './Waterline.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = dict(lang);
---

<Waterline />
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__wordmark">THE VIEW<br /><span>LUGANO</span></p>
      <!-- Key guest-facing facts stated in plain declarative prose,
           server-rendered — readable by people and answer engines alike. -->
      <p class="footer__fact">{t.footer.factLine}</p>
      <p class="footer__fact">
        {SITE.address.street}, {SITE.address.postalCode} {SITE.address.locality}, {SITE.address.countryName}<br />
        {t.common.phone} <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a> ·
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a> ·
        <a href={`https://wa.me/${SITE.whatsapp}`} rel="noopener">WhatsApp</a>
      </p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <a href={p(lang, 'suites')}>{t.nav.suites}</a>
      <a href={p(lang, 'dining')}>{t.nav.dining}</a>
      <a href={p(lang, 'spa')}>{t.nav.spa}</a>
      <a href={p(lang, 'experiences')}>{t.nav.experiences}</a>
      <a href={p(lang, 'events')}>{t.nav.events}</a>
      <a href={p(lang, 'gallery')}>{t.nav.gallery}</a>
      <a href={p(lang, 'location')}>{t.nav.location}</a>
      <a href={p(lang, 'sustainability')}>{t.nav.sustainability}</a>
      <a href={p(lang, 'press')}>{t.nav.press}</a>
      <a href={p(lang, 'journal')}>{t.nav.journal}</a>
      <a href={p(lang, 'contact')}>{t.nav.contact}</a>
      <a href={egumaUrl('vouchers', lang)} rel="noopener">{t.common.vouchers}</a>
    </nav>
  </div>

  <div class="container footer__credentials">
    <p class="eyebrow">{t.footer.credentials}</p>
    <!-- The quiet credentials strip: one row, text, no badge wall.
         The full award set is carried in Hotel JSON-LD structured data. -->
    <ul class="footer__awards" aria-label={t.footer.credentials}>
      {SITE.awards.map((a) => <li>{a.name}</li>)}
    </ul>
  </div>

  <div class="container footer__legal">
    <p>{t.footer.partOf}</p>
    <div class="footer__legal-links">
      <a href={p(lang, 'legal', 'impressum')}>{t.nav.impressum}</a>
      <a href={p(lang, 'legal', 'privacy')}>{t.nav.privacy}</a>
      <a href={p(lang, 'legal', 'terms')}>{t.nav.terms}</a>
      <a href={p(lang, 'legal', 'cookies')}>{t.nav.cookies}</a>
      <button type="button" data-open-consent>{t.legal.cookieSettings}</button>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--tortora);
    padding-block: var(--space-5) var(--space-3);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .footer__wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.32em;
    font-size: 1.05rem;
    margin-bottom: var(--space-3);
  }
  .footer__wordmark span {
    font-weight: 300;
    font-size: 0.8rem;
    letter-spacing: 0.55em;
  }
  .footer__fact {
    font-size: 0.92rem;
    color: var(--ink);
    max-width: 46ch;
  }
  .footer__fact a {
    border-bottom: 1px solid var(--clay);
  }
  .footer__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem 1.5rem;
    align-content: start;
  }
  .footer__nav a {
    font-size: 0.9rem;
    padding-block: 0.35rem;
    color: var(--ink);
  }
  .footer__awards {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
  }
  .footer__awards li {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--clay);
    white-space: nowrap;
  }
  .footer__legal {
    border-top: 1px solid var(--tortora-densa);
    padding-top: var(--space-3);
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: 0.82rem;
  }
  .footer__legal p {
    color: var(--clay);
    margin: 0;
  }
  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .footer__legal-links a,
  .footer__legal-links button {
    font-size: 0.82rem;
    color: var(--clay);
    background: none;
    border: 0;
    padding: 0.3rem 0;
    cursor: pointer;
    font-family: var(--font-body);
  }
  @media (max-width: 820px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
