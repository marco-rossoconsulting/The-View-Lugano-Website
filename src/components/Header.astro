---
import { dict, p, type Locale } from '../lib/i18n';
import { egumaUrl, simpleBookingUrl } from '../lib/site';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props { lang: Locale; route: string; overlay?: boolean }
const { lang, route, overlay = false } = Astro.props;
const t = dict(lang);

const links: { href: string; label: string }[] = [
  { href: p(lang), label: t.nav.home },
  { href: p(lang, 'suites'), label: t.nav.suites },
  { href: p(lang, 'dining'), label: t.nav.dining },
  { href: p(lang, 'spa'), label: t.nav.spa },
  { href: p(lang, 'experiences'), label: t.nav.experiences },
  { href: p(lang, 'events'), label: t.nav.events },
  { href: p(lang, 'gallery'), label: t.nav.gallery },
  { href: p(lang, 'location'), label: t.nav.location },
  { href: p(lang, 'sustainability'), label: t.nav.sustainability },
  { href: p(lang, 'press'), label: t.nav.press },
  { href: p(lang, 'journal'), label: t.nav.journal },
  { href: p(lang, 'contact'), label: t.nav.contact },
];
---

<a class="skip-link" href="#main">{t.common.skip}</a>

<header class={`header${overlay ? ' header--overlay' : ''}`}>
  <a class="wordmark" href={p(lang)} aria-label="THE VIEW Lugano">
    <img src="/logo.png" alt="THE VIEW Lugano" width="153" height="77" class="wordmark__img" />
  </a>

  <div class="header__actions">
    <LanguageSwitcher lang={lang} route={route} compact />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span data-label-open>{t.nav.menuOpen}</span>
      <span data-label-close hidden>{t.nav.menuClose}</span>
    </button>
    <a class="reserve-btn" href={simpleBookingUrl(lang)} rel="noopener">{t.common.reserve}</a>
  </div>
</header>

<nav id="site-menu" class="menu" hidden aria-label="Site">
  <button class="menu-close" type="button" data-menu-close aria-label={t.nav.menuClose}>
    <span>{t.nav.menuClose}</span>
  </button>
  <div class="menu__inner container">
    <ul class="menu__list">
      {links.map((l) => (
        <li><a href={l.href} aria-current={`/${lang}${route ? `/${route}` : ''}/` === l.href ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <div class="menu__aside">
      <LanguageSwitcher lang={lang} route={route} />
      <div class="menu__shop">
        <a href={egumaUrl('vouchers', lang)} rel="noopener">{t.common.vouchers}</a>
        <a href={egumaUrl('events', lang)} rel="noopener">{t.common.eventsShop}</a>
      </div>
      <div class="menu__legal">
        <a href={p(lang, 'legal', 'impressum')}>{t.nav.impressum}</a>
        <a href={p(lang, 'legal', 'privacy')}>{t.nav.privacy}</a>
        <a href={p(lang, 'legal', 'terms')}>{t.nav.terms}</a>
        <a href={p(lang, 'legal', 'cookies')}>{t.nav.cookies}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('site-menu');
  const labelOpen = toggle?.querySelector('[data-label-open]');
  const labelClose = toggle?.querySelector('[data-label-close]');
  const header = document.querySelector('.header');
  function setMenu(open: boolean) {
    if (!toggle || !menu || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    labelOpen?.toggleAttribute('hidden', open);
    labelClose?.toggleAttribute('hidden', !open);
    header.classList.toggle('header--hidden', open);
    menu.classList.toggle('menu--full', open);
  }
  toggle?.addEventListener('click', () => setMenu(menu?.hidden ?? true));
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Homepage overlay header: transparent at top, solid on scroll
  const overlayHeader = document.querySelector('.header--overlay');
  if (overlayHeader) {
    function updateHeader() {
      overlayHeader.classList.toggle('header--scrolled', window.scrollY > 0);
    }
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem clamp(1.25rem, 4vw, 3.5rem);
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--tortora-densa);
  }
  .header--overlay {
    position: fixed;
    inset-inline: 0;
    top: 0;
    background: color-mix(in srgb, var(--ground) 25%, transparent);
    transition: background-color 200ms ease;
  }
  .header--overlay.header--scrolled {
    background: color-mix(in srgb, var(--ground) 92%, transparent);
  }
  .wordmark {
    color: var(--ink);
    display: inline-flex;
  }
  .wordmark__img {
    width: 153px;
    height: 77px;
    object-fit: contain;
    display: block;
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .menu-btn,
  .reserve-btn {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    padding: 0.85rem 1.4rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .menu-btn {
    background: none;
    border: 0;
    color: var(--ink);
  }
  /* The persistent Reserve affordance: slim, always available, never a popup */
  .reserve-btn {
    border: 1px solid var(--ink);
    color: var(--ink);
    transition: background-color 250ms ease, color 250ms ease;
  }
  .reserve-btn:hover,
  .reserve-btn:focus-visible {
    background: var(--ink);
    color: var(--ground);
  }
  .menu {
    position: fixed;
    inset: 0;
    z-index: 39;
    background: var(--ground);
    overflow-y: auto;
    padding-top: 96px;
  }
  .menu__inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-4);
  }
  .menu__list a {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.4rem, 3vw, 2rem);
    padding-block: 0.55rem;
    color: var(--ink);
  }
  .menu__list a[aria-current='page'] {
    color: var(--clay);
  }
  .menu__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: 0.75rem;
  }
  .menu__shop,
  .menu__legal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .menu__shop a {
    font-family: var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.82rem;
    color: var(--ink);
    padding-block: 0.4rem;
  }
  .menu__legal a {
    font-size: 0.82rem;
    color: var(--clay);
    padding-block: 0.3rem;
  }
  .header--hidden {
    display: none;
  }
  .menu--full {
    top: 0;
  }
  .menu-close {
    position: absolute;
    top: 0.5rem;
    right: clamp(1.25rem, 4vw, 3.5rem);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    padding: 0.85rem 1.4rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    background: none;
    border: 0;
    color: var(--ink);
    z-index: 2;
  }
  @media (max-width: 820px) {
    .menu__inner {
      grid-template-columns: 1fr;
    }
    .menu__list {
      columns: 1;
    }
  }
  @media (max-width: 480px) {
    .wordmark__img {
      width: 120px;
      height: 61px;
    }
    .menu {
      padding-top: 80px;
    }
    .menu-btn,
    .reserve-btn,
    .menu-close {
      padding: 0.65rem 0.9rem;
      font-size: 0.72rem;
      letter-spacing: 0.2em;
    }
    .header {
      padding: 0.5rem 1rem;
    }
  }
</style>
