---
import { dict, p, type Locale } from '../lib/i18n';
import { egumaUrl, simpleBookingUrl } from '../lib/site';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props { lang: Locale; route: string }
const { lang, route } = Astro.props;
const t = dict(lang);

const links: { href: string; label: string }[] = [
  { href: p(lang), label: t.nav.home },
  { href: p(lang, 'suites'), label: t.nav.suites },
  { href: p(lang, 'dining'), label: t.nav.dining },
  { href: p(lang, 'spa'), label: t.nav.spa },
  { href: p(lang, 'experiences'), label: t.nav.experiences },
  { href: p(lang, 'events'), label: t.nav.events },
  { href: p(lang, 'gallery'), label: t.nav.gallery },
  { href: p(lang, 'location'), label: t.nav.location },
  { href: p(lang, 'sustainability'), label: t.nav.sustainability },
  { href: p(lang, 'press'), label: t.nav.press },
  { href: p(lang, 'journal'), label: t.nav.journal },
  { href: p(lang, 'contact'), label: t.nav.contact },
];
---

<a class="skip-link" href="#main">{t.common.skip}</a>

<header class="header">
  <a class="wordmark" href={p(lang)} aria-label="THE VIEW Lugano">
    <!-- Logo lettering per CI 2015: THE VIEW (Futura TT Regular) / LUGANO (Futura Light) -->
    <svg viewBox="0 0 176 44" width="132" height="33" role="img" aria-hidden="true" focusable="false">
      <text x="0" y="18" font-family="Jost, Futura, sans-serif" font-weight="400" font-size="19" letter-spacing="4.2" fill="currentColor">THE VIEW</text>
      <text x="0" y="39" font-family="Jost, Futura, sans-serif" font-weight="300" font-size="12.5" letter-spacing="7.4" fill="currentColor">LUGANO</text>
    </svg>
  </a>

  <div class="header__actions">
    <LanguageSwitcher lang={lang} route={route} />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span data-label-open>{t.nav.menuOpen}</span>
      <span data-label-close hidden>{t.nav.menuClose}</span>
    </button>
    <a class="reserve-btn" href={simpleBookingUrl(lang)} rel="noopener">{t.common.reserve}</a>
  </div>
</header>

<nav id="site-menu" class="menu" hidden aria-label="Site">
  <div class="menu__inner container">
    <ul class="menu__list">
      {links.map((l) => (
        <li><a href={l.href} aria-current={`/${lang}${route ? `/${route}` : ''}/` === l.href ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <div class="menu__aside">
      <LanguageSwitcher lang={lang} route={route} />
      <div class="menu__shop">
        <a href={egumaUrl('vouchers', lang)} rel="noopener">{t.common.vouchers}</a>
        <a href={egumaUrl('events', lang)} rel="noopener">{t.common.eventsShop}</a>
      </div>
      <div class="menu__legal">
        <a href={p(lang, 'legal', 'impressum')}>{t.nav.impressum}</a>
        <a href={p(lang, 'legal', 'privacy')}>{t.nav.privacy}</a>
        <a href={p(lang, 'legal', 'terms')}>{t.nav.terms}</a>
        <a href={p(lang, 'legal', 'cookies')}>{t.nav.cookies}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('site-menu');
  const labelOpen = toggle?.querySelector('[data-label-open]');
  const labelClose = toggle?.querySelector('[data-label-close]');
  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    labelOpen?.toggleAttribute('hidden', open);
    labelClose?.toggleAttribute('hidden', !open);
  }
  toggle?.addEventListener('click', () => setMenu(menu?.hidden ?? true));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem clamp(1.25rem, 4vw, 3.5rem);
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--tortora-densa);
  }
  .wordmark {
    color: var(--ink);
    display: inline-flex;
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header__actions :global(.langs) {
    gap: 0.6rem;
    margin-right: 0.5rem;
  }
  .header__actions :global(.langs a) {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    padding: 0.4rem 0.2rem;
    color: var(--clay);
  }
  .header__actions :global(.langs a[aria-current='page']) {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .menu-btn,
  .reserve-btn {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    padding: 0.85rem 1.4rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .menu-btn {
    background: none;
    border: 0;
    color: var(--ink);
  }
  /* The persistent Reserve affordance: slim, always available, never a popup */
  .reserve-btn {
    border: 1px solid var(--ink);
    color: var(--ink);
    transition: background-color 250ms ease, color 250ms ease;
  }
  .reserve-btn:hover,
  .reserve-btn:focus-visible {
    background: var(--ink);
    color: var(--ground);
  }
  .menu {
    position: fixed;
    inset: 0;
    top: 66px;
    z-index: 39;
    background: var(--ground);
    overflow-y: auto;
  }
  .menu__inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-4);
  }
  .menu__list a {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.4rem, 3vw, 2rem);
    padding-block: 0.55rem;
    color: var(--ink);
  }
  .menu__list a[aria-current='page'] {
    color: var(--clay);
  }
  .menu__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: 0.75rem;
  }
  .menu__shop,
  .menu__legal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .menu__shop a {
    font-family: var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.82rem;
    color: var(--ink);
    padding-block: 0.4rem;
  }
  .menu__legal a {
    font-size: 0.82rem;
    color: var(--clay);
    padding-block: 0.3rem;
  }
  @media (max-width: 820px) {
    .menu__inner {
      grid-template-columns: 1fr;
    }
    .menu__list {
      columns: 1;
    }
  }
</style>
