---
// Compact guest-commentary treatment for paired testimonials.
interface Props {
  quotes: string[];
}
const { quotes } = Astro.props;
---

<div class="guest-quotes">
  {quotes.map((quote, index) => (
    <blockquote
      class:list={['guest-quotes__item', 'fade-up', index === 1 && 'guest-quotes__item--second']}
    >
      <span class="guest-quotes__mark" aria-hidden="true">“</span>
      <p class="guest-quotes__text">{quote}</p>
    </blockquote>
  ))}
</div>

<style>
  .guest-quotes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 7vw, 7rem);
    max-width: 74rem;
    margin: 0;
    margin-inline: auto;
  }

  .guest-quotes::before {
    content: '';
    position: absolute;
    inset-block: 0.75rem;
    inset-inline-start: 50%;
    width: 1px;
    background: var(--argento);
  }

  .guest-quotes__item {
    margin: 0;
    padding-inline: clamp(0rem, 2vw, 1.5rem);
  }

  .guest-quotes__mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3rem, 5vw, 4.25rem);
    line-height: 0.6;
    color: var(--clay);
    margin-bottom: 1.25rem;
  }

  .guest-quotes__text {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 1.42;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }

  @media (max-width: 720px) {
    .guest-quotes {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .guest-quotes::before {
      display: none;
    }

    .guest-quotes__item {
      padding-inline: 0;
    }

    .guest-quotes__item--second {
      border-top: 1px solid var(--argento);
      padding-top: var(--space-3);
    }
  }
</style>
