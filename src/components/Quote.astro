---
// Pull-quote treatment for guest commentary.
interface Props {
  quote: string;
  attribution?: string;
}
const { quote, attribution } = Astro.props;
---

<blockquote class="quote fade-up">
  <span class="quote__mark" aria-hidden="true">"</span>
  <p class="quote__text">{quote}</p>
  {attribution && <cite class="quote__attribution">{attribution}</cite>}
</blockquote>

<style>
  .quote {
    margin: 0;
    text-align: center;
    max-width: 56ch;
    margin-inline: auto;
  }
  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 0.6;
    color: var(--tortora-densa);
    margin-bottom: var(--space-2);
  }
  .quote__text {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 var(--space-2);
    text-wrap: balance;
  }
  .quote__attribution {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--clay);
    font-style: normal;
  }
</style>
