---
// The guest-commentary moment, read as quotes rather than stacked prose.
// Large light-weight display type + a hairline rule — no new color, no
// silver (argento stays reserved for the waterline).
interface Props {
  eyebrow: string;
  title: string;
  quotes: string[];
}
const { eyebrow, title, quotes } = Astro.props;
---

<div class="quote-block fade-up">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="quote-block__title">{title}</h2>
  <div class="quote-block__list">
    {quotes.map((q) => (
      <blockquote class="quote-block__item">
        <p>{q}</p>
      </blockquote>
    ))}
  </div>
</div>

<style>
  .quote-block__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    max-width: 42ch;
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }
  .quote-block__list {
    display: grid;
    gap: var(--space-4);
  }
  .quote-block__item {
    margin: 0;
    padding-left: var(--space-3);
    border-left: 1px solid var(--tortora-densa);
  }
  .quote-block__item p {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    line-height: 1.6;
    color: var(--ink);
    max-width: 54ch;
    margin: 0;
    text-wrap: balance;
  }
  @media (max-width: 640px) {
    .quote-block__item {
      padding-left: var(--space-2);
    }
  }
</style>
