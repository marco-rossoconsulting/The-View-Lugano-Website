---
import { getCollection } from 'astro:content';
import type { Locale } from '../../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;

const [faqEntries, settingsEntries] = await Promise.all([
  getCollection('faq'),
  getCollection('settings'),
]);

const items = faqEntries.sort((a, b) => a.data.order - b.data.order);
const settings = settingsEntries[0]?.data;
const faqTitle = settings?.common?.faqTitle?.[lang] ?? 'FAQ';
---

<section class="section">
  <div class="container container--narrow">
    <h2 class="faq-title">{faqTitle}</h2>
    <ul class="faq">
      {items.map((item) => (
        <li class="faq__item">
          <details class="faq__details">
            <summary class="faq__q">{item.data.question[lang]}</summary>
            <p class="faq__a">{item.data.answer[lang]}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .faq-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    margin-bottom: var(--space-3);
  }
  .faq { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .faq__item { border-top: 1px solid var(--tortora-densa); }
  .faq__item:last-child { border-bottom: 1px solid var(--tortora-densa); }
  .faq__details { padding: 1rem 0; }
  .faq__q {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 300;
    color: var(--clay);
    flex-shrink: 0;
  }
  .faq__details[open] .faq__q::after { content: '–'; }
  .faq__a {
    max-width: 62ch;
    padding-top: 0.75rem;
    color: var(--clay);
  }
</style>
