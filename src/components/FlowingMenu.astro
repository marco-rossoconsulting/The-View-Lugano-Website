---
// A light Astro adaptation of the React Bits FlowingMenu pattern. Keeping this
// as a small vanilla island avoids shipping React and GSAP solely for a
// hover-state interaction on an otherwise static-first site.
interface MenuItem {
  href: string;
  label: string;
  image: string;
}

interface Props {
  items: MenuItem[];
  ariaLabel: string;
}

const { items, ariaLabel } = Astro.props;
const repetitions = Array.from({ length: 5 });
---

<section class="flowing-menu" aria-label={ariaLabel}>
  <h2 class="visually-hidden">{ariaLabel}</h2>
  <nav class="flowing-menu__nav" aria-label={ariaLabel}>
    <ul class="flowing-menu__list">
      {items.map((item) => (
        <li class="flowing-menu__item" data-flowing-menu-item data-image={item.image}>
          <a class="flowing-menu__link" href={item.href}>
            <span class="flowing-menu__label">{item.label}</span>
            <span class="flowing-menu__marquee" aria-hidden="true">
              <span class="flowing-menu__marquee-clip">
                <span class="flowing-menu__track">
                  {repetitions.map(() => (
                    <span class="flowing-menu__part">
                      <span>{item.label}</span>
                      <span class="flowing-menu__image"></span>
                    </span>
                  ))}
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<script>
  // Load each small hover image only when its action receives attention.
  // This keeps the conversion menu from adding image requests to the hero's
  // initial render path.
  document.querySelectorAll<HTMLElement>('[data-flowing-menu-item]').forEach((item) => {
    const activateImage = () => {
      if (item.dataset.imageLoaded === 'true') return;
      const image = item.dataset.image;
      if (!image) return;
      item.style.setProperty('--flowing-menu-image', `url("${image}")`);
      item.dataset.imageLoaded = 'true';
    };

    item.addEventListener('pointerenter', activateImage, { passive: true });
    item.querySelector('a')?.addEventListener('focus', activateImage);
  });
</script>

<style>
  .flowing-menu {
    background: var(--ink);
    color: var(--tortora);
    overflow: hidden;
  }

  .flowing-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flowing-menu__item {
    position: relative;
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--tortora) 32%, transparent);
  }

  .flowing-menu__item:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--tortora) 32%, transparent);
  }

  .flowing-menu__link {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(4.8rem, 8vw, 6.8rem);
    padding: 0.8rem clamp(1.25rem, 7vw, 6rem);
    overflow: hidden;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .flowing-menu__label,
  .flowing-menu__part {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.7vw, 2.35rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flowing-menu__label {
    transition: opacity 180ms ease;
  }

  .flowing-menu__marquee {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--tortora);
    color: var(--ink);
    pointer-events: none;
    transform: translate3d(0, 102%, 0);
    transition: transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .flowing-menu__marquee-clip {
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transform: translate3d(0, -102%, 0);
    transition: transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .flowing-menu__track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .flowing-menu__part {
    display: inline-flex;
    align-items: center;
    flex: none;
    padding-inline: clamp(0.8rem, 1.7vw, 1.6rem);
  }

  .flowing-menu__image {
    width: clamp(6.25rem, 12vw, 11rem);
    aspect-ratio: 3 / 2;
    margin-left: clamp(0.85rem, 1.8vw, 1.75rem);
    background-color: var(--clay);
    background-image: var(--flowing-menu-image, none);
    background-position: center;
    background-size: cover;
  }

  .flowing-menu__link:hover .flowing-menu__marquee,
  .flowing-menu__link:focus-visible .flowing-menu__marquee,
  .flowing-menu__link:hover .flowing-menu__marquee-clip,
  .flowing-menu__link:focus-visible .flowing-menu__marquee-clip {
    transform: translate3d(0, 0, 0);
  }

  .flowing-menu__link:hover .flowing-menu__track,
  .flowing-menu__link:focus-visible .flowing-menu__track {
    animation: flowing-menu-scroll 16s linear infinite;
  }

  .flowing-menu__link:active {
    transform: scale(0.995);
  }

  @keyframes flowing-menu-scroll {
    to { transform: translate3d(-20%, 0, 0); }
  }

  @media (max-width: 720px) {
    .flowing-menu__link {
      min-height: 4.65rem;
    }

    .flowing-menu__label,
    .flowing-menu__part {
      font-size: clamp(1rem, 5.2vw, 1.45rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flowing-menu__marquee,
    .flowing-menu__marquee-clip {
      transition: none;
    }

    .flowing-menu__link:hover .flowing-menu__track,
    .flowing-menu__link:focus-visible .flowing-menu__track {
      animation: none;
    }
  }
</style>
