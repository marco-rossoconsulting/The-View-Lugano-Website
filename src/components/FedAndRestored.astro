---
import { Picture } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import diningImage from '../assets/images/rituals/fine-dining-ritual.jpg';
import spaImage from '../assets/images/rituals/spa-ritual.jpg';

interface Ritual {
  eyebrow?: string;
  title: string;
  body: string[];
  cta: {
    href: string;
    label: string;
  };
  alt: string;
}

interface Props {
  title: string;
  subtitle: string;
  dining: Ritual;
  spa: Ritual;
}

const { title, subtitle, dining, spa } = Astro.props;

const rituals = [
  { ...dining, image: diningImage },
  { ...spa, image: spaImage },
];
---

<section class="section section--tortora rituals">
  <div class="container">
    <div class="rituals__header fade-up">
      <SectionHeader title={title} />
      <p class="rituals__subtitle">{subtitle}</p>
    </div>

    <div class="rituals__grid">
      {rituals.map((ritual, index) => (
        <article class="ritual-card fade-up" style={`transition-delay: ${index * 110}ms`}>
          <Picture
            src={ritual.image}
            alt={ritual.alt}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 820px) 100vw, 50vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading="lazy"
            decoding="async"
          />
          <div class="ritual-card__content">
            <div class="ritual-card__introduction">
              {ritual.eyebrow && <p class="eyebrow ritual-card__eyebrow">{ritual.eyebrow}</p>}
              <h3>{ritual.title}</h3>
            </div>

            <div class="ritual-card__closing">
              <div class="ritual-card__body">
                {ritual.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <a class="ritual-card__cta" href={ritual.cta.href}>{ritual.cta.label}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .rituals__header {
    max-width: 47rem;
    margin-bottom: clamp(2.75rem, 5vw, 4.5rem);
  }

  .rituals__header :global(.section-header__title) {
    margin-bottom: var(--space-2);
  }

  .rituals__subtitle {
    margin: 0;
    color: var(--clay);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
  }

  .rituals__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .ritual-card {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(34rem, 48vw, 43rem);
    overflow: hidden;
    background: var(--ink);
  }

  .ritual-card::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    background: linear-gradient(
      180deg,
      rgb(25 19 12 / 0.78) 0%,
      rgb(25 19 12 / 0.2) 46%,
      rgb(25 19 12 / 0.9) 100%
    );
  }

  .ritual-card :global(picture),
  .ritual-card :global(img) {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ritual-card :global(img) {
    max-width: none;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .ritual-card:nth-child(1) :global(img) {
    object-position: center;
  }

  .ritual-card:nth-child(2) :global(img) {
    object-position: center 42%;
  }

  .ritual-card:hover :global(img) {
    transform: scale(1.035);
  }

  .ritual-card__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--white);
  }

  .ritual-card__introduction h3 {
    max-width: 22ch;
    margin: 0;
    color: inherit;
    font-size: clamp(1.45rem, 2.3vw, 2.15rem);
    font-weight: 300;
    line-height: 1.2;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.4);
  }

  .ritual-card__eyebrow {
    margin-bottom: 0.8rem;
    color: var(--tortora);
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.5);
  }

  .ritual-card__closing {
    align-self: end;
  }

  .ritual-card__body {
    max-width: 39rem;
    margin-bottom: 1.5rem;
    font-size: clamp(0.92rem, 1.25vw, 1rem);
    line-height: 1.75;
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.55);
  }

  .ritual-card__body p {
    max-width: none;
    margin-bottom: 0.8rem;
  }

  .ritual-card__body p:last-child {
    margin-bottom: 0;
  }

  .ritual-card__cta {
    display: inline-block;
    min-height: 44px;
    padding: 0.73rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.86);
    background: rgb(25 19 12 / 0.48);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    line-height: 1.2;
    text-transform: uppercase;
    transition: background-color 260ms ease, color 260ms ease, border-color 260ms ease;
  }

  .ritual-card__cta:hover,
  .ritual-card__cta:focus-visible {
    border-color: var(--tortora);
    background: var(--tortora);
    color: var(--ink);
  }

  @media (max-width: 820px) {
    .rituals__grid {
      grid-template-columns: 1fr;
    }

    .ritual-card {
      min-height: clamp(32rem, 105vw, 42rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ritual-card :global(img) {
      transition: none;
    }
  }
</style>
