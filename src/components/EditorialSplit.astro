---
// The core layout rhythm: asymmetric photo/text pairs that alternate sides.
// 7 columns of photograph, 4 of text, 1 of air — never a symmetric card grid.
import Pic from './Pic.astro';
import SectionHeader from './SectionHeader.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  flip?: boolean;
  headingLevel?: 'h2' | 'h3';
  cta?: { href: string; label: string };
  imageWidth?: number;
  imageHeight?: number;
  imageWidths?: number[];
}
const {
  src,
  alt,
  eyebrow,
  title,
  flip = false,
  headingLevel = 'h2',
  cta,
  imageWidth = 1600,
  imageHeight = 1067,
  imageWidths,
} = Astro.props;
---

<div class={`editorial fade-up${flip ? ' editorial--flip' : ''}`}>
  <div class="editorial__photo">
    <Pic
      {src}
      {alt}
      width={imageWidth}
      height={imageHeight}
      widths={imageWidths}
      sizes="(max-width: 900px) 100vw, 58vw"
    />
  </div>
  <div class="editorial__text">
    <SectionHeader {eyebrow} {title} headingLevel={headingLevel} />
    <div class="editorial__body"><slot /></div>
    {cta && <a class="btn" href={cta.href}>{cta.label}</a>}
  </div>
</div>

<style>
  .editorial {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  .editorial--flip {
    grid-template-columns: 4fr 7fr;
  }
  .editorial--flip .editorial__photo { order: 2; }
  .editorial--flip .editorial__text { order: 1; }
  .editorial__photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transform: scale(1.04);
    transition: transform 1.2s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .editorial.is-visible .editorial__photo :global(img) {
    transform: scale(1);
  }
  .editorial__body :global(p) {
    margin-bottom: 1rem;
  }
  .editorial__body :global(p:last-child) { margin-bottom: 0; }
  .editorial__text .btn { margin-top: var(--space-2); }
  @media (max-width: 900px) {
    .editorial,
    .editorial--flip {
      grid-template-columns: 1fr;
    }
    .editorial--flip .editorial__photo { order: 1; }
    .editorial--flip .editorial__text { order: 2; }
  }
</style>
