---
import Base from '../layouts/Base.astro';
import { dict } from '../lib/i18n';
const t = dict('en');
---
<Base lang="en" title="404 — THE VIEW Lugano" description={t.notFound.body} route="404">
  <section class="section">
    <div class="container container--narrow">
      <h1 style="font-family: var(--font-display); font-weight: 300; font-size: clamp(1.8rem,4vw,2.6rem); margin-bottom: var(--space-2);">{t.notFound.title}</h1>
      <p style="max-width: 50ch; margin-bottom: var(--space-3);">{t.notFound.body}</p>
      <a class="btn" href="/en/">{t.notFound.cta}</a>
    </div>
  </section>
</Base>
