---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { SITE } from '../../lib/site';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const pageEntries = await getCollection('pages');
const page = pageEntries.find((e) => e.data.slug === 'press')?.data;
if (!page) throw new Error('Missing press CMS content');
---

<Base {lang} title={page.metaTitle[lang]} description={page.metaDesc[lang]} route="press">
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro">{page.intro[lang]}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container container--narrow">
      <ul class="awards-list">
        {SITE.awards.map((a) => <li>{a.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow press-grid">
      <div>
        <h2 class="section-title">{page.mediaTitle?.[lang]}</h2>
        <p style="max-width: 56ch; margin-bottom: var(--space-2);">{page.mediaBody?.[lang]}</p>
        <a class="btn" href={`mailto:${SITE.email}`}>Write to us</a>
      </div>
      <div>
        <h2 class="section-title">{page.factsTitle?.[lang]}</h2>
        <p style="max-width: 56ch;">{page.factsBody?.[lang]}</p>
      </div>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'press') },
    ])}
  />
</Base>

<style>
  .awards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .awards-list li {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    letter-spacing: 0.06em;
    padding: 1rem 0;
    border-bottom: 1px solid var(--tortora-densa);
  }
  .awards-list li:first-child { border-top: 1px solid var(--tortora-densa); }
  .press-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    margin-bottom: var(--space-2);
  }
  @media (max-width: 820px) { .press-grid { grid-template-columns: 1fr; } }
</style>
