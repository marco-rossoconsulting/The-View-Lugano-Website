---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import JsonLd from '../../components/JsonLd.astro';
import Waterline from '../../components/Waterline.astro';
import { localePaths, dict, p, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const t = dict(lang);
---

<Base {lang} title={t.press.metaTitle} description={t.press.metaDesc} route="press">
  <Breadcrumbs {lang} crumbs={[{ label: t.nav.press }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{t.press.h1}</h1>
      <p class="page-intro">{t.press.intro}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container container--narrow">
      <!-- Recognition, once and clearly. No badge wall. -->
      <ul class="awards-list">
        {SITE.awards.map((a) => <li>{a.name}</li>)}
      </ul>
    </div>
  </section>

  <TrustBadges {lang} />

  <div class="container"><Waterline /></div>

  <section class="section">
    <div class="container container--narrow press-grid">
      <div>
        <h2 class="section-title">{t.press.mediaTitle}</h2>
        <p style="max-width: 56ch; margin-bottom: var(--space-2);">{t.press.mediaBody}</p>
        <a class="btn" href={`mailto:${SITE.email}`}>{t.common.writeUs}</a>
      </div>
      <div>
        <h2 class="section-title">{t.press.factsTitle}</h2>
        <!-- Fact sheet register: the one guest-adjacent surface where the
             five-star classification is stated (Brand Bible §10.3). -->
        <p style="max-width: 56ch;">{t.press.factsBody}</p>
      </div>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: t.nav.home, url: p(lang) },
      { name: t.nav.press, url: p(lang, 'press') },
    ])}
  />
</Base>

<style>
  .awards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .awards-list li {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    letter-spacing: 0.06em;
    padding: 1rem 0;
    border-bottom: 1px solid var(--tortora-densa);
  }
  .awards-list li:first-child { border-top: 1px solid var(--tortora-densa); }
  .press-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    margin-bottom: var(--space-2);
  }
  @media (max-width: 820px) { .press-grid { grid-template-columns: 1fr; } }
</style>
