---
import Base from '../../layouts/Base.astro';
import EventsPaths from '../../components/EventsPaths.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { dict, localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { egumaUrl } from '../../lib/site';
import { byCategory } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);
const t = dict(lang);

const pageEntries = await getCollection('pages');
const page = pageEntries.find((e) => e.data.slug === 'events')?.data;
if (!page) throw new Error('Missing events CMS content');
if (!page.privateTitle || !page.privateBody) throw new Error('Missing events private CMS fields');
if (!page.meetingTitle || !page.meetingBody) throw new Error('Missing events meeting CMS fields');
if (!page.buyoutTitle || !page.buyoutBody) throw new Error('Missing events buyout CMS fields');
if (!page.cta) throw new Error('Missing events CTA CMS field');

const eventsPhoto = byCategory('events')[0];
const meetingPhoto = byCategory('meeting')[0];
const terracePhoto = byCategory('terrace')[0];
if (!eventsPhoto || !meetingPhoto || !terracePhoto) {
  throw new Error('Missing events / meeting / terrace photography');
}

const contactHref = p(lang, 'contact');
const ticketsHref = egumaUrl('events', lang);

const paths = [
  {
    id: 'private',
    index: '01',
    title: page.privateTitle[lang],
    body: page.privateBody[lang],
    src: eventsPhoto.src,
    alt: eventsPhoto.alt[lang],
    href: contactHref,
    cta: page.cta[lang],
  },
  {
    id: 'meetings',
    index: '02',
    title: page.meetingTitle[lang],
    body: page.meetingBody[lang],
    src: meetingPhoto.src,
    alt: meetingPhoto.alt[lang],
    href: contactHref,
    cta: page.cta[lang],
  },
  {
    id: 'buyout',
    index: '03',
    title: page.buyoutTitle[lang],
    body: page.buyoutBody[lang],
    src: terracePhoto.src,
    alt: terracePhoto.alt[lang],
    href: contactHref,
    cta: page.cta[lang],
  },
];
---

<Base
  {lang}
  title={page.metaTitle[lang]}
  description={page.metaDesc[lang]}
  route="events"
  ogImage={eventsPhoto.src}
>
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section events-intro">
    <div class="container container--narrow">
      <p class="eyebrow">{t.events.eyebrow}</p>
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro lede">{page.intro[lang]}</p>
    </div>
  </section>

  <EventsPaths
    title={t.events.explore}
    note={t.events.exploreNote}
    cards={paths}
  />

  <section class="section events-enquire" id="enquire" aria-labelledby="events-enquire-title">
    <div class="container container--narrow">
      <h2 id="events-enquire-title" class="visually-hidden">{page.cta[lang]}</h2>
      {page.honest?.[lang] && <p class="events-enquire__honest">{page.honest[lang]}</p>}
      <nav class="events-enquire__paths" aria-label={t.events.jumpLabel}>
        {paths.map((path) => (
          <a href={`#${path.id}`}>
            <span aria-hidden="true">{path.index}</span>
            {path.title}
          </a>
        ))}
      </nav>
      <div class="events-enquire__actions">
        <a class="btn btn--solid" href={contactHref}>{page.cta[lang]}</a>
        <a class="btn" href={ticketsHref} rel="noopener">{t.common.eventsShop}</a>
      </div>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'events') },
    ])}
  />
</Base>

<style>
  .events-intro {
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .events-enquire {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .events-enquire__honest {
    max-width: 62ch;
    margin-bottom: var(--space-3);
    font-size: 1.02rem;
    line-height: 1.8;
  }
  .events-enquire__paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-bottom: var(--space-3);
  }
  .events-enquire__paths a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    border-bottom: 1px solid transparent;
    padding-block: 0.25rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .events-enquire__paths a span {
    color: var(--clay);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.18em;
  }
  .events-enquire__paths a:hover,
  .events-enquire__paths a:focus-visible {
    border-bottom-color: var(--ink);
    color: var(--clay);
  }
  .events-enquire__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .events-enquire__paths a {
      transition: none;
    }
  }
</style>
