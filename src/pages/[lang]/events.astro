---
import Base from '../../layouts/Base.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { egumaUrl } from '../../lib/site';
import { byCategory } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const pageEntries = await getCollection('pages');
const page = pageEntries.find((e) => e.data.slug === 'events')?.data;
if (!page) throw new Error('Missing events CMS content');

const eventsPhoto = byCategory('events')[0];
const meetingPhoto = byCategory('meeting')[0];
const terracePhoto = byCategory('terrace')[0];
---

<Base {lang} title={page.metaTitle[lang]} description={page.metaDesc[lang]} route="events">
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro">{page.intro[lang]}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <EditorialSplit
        src={eventsPhoto.src}
        alt={eventsPhoto.alt[lang]}
        title={page.privateTitle?.[lang]}
      >
        <p>{page.privateBody?.[lang]}</p>
      </EditorialSplit>
    </div>
  </section>

  <section class="section section--tortora">
    <div class="container">
      <EditorialSplit
        src={meetingPhoto.src}
        alt={meetingPhoto.alt[lang]}
        title={page.meetingTitle?.[lang]}
        flip
      >
        <p>{page.meetingBody?.[lang]}</p>
      </EditorialSplit>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EditorialSplit
        src={terracePhoto.src}
        alt={terracePhoto.alt[lang]}
        title={page.buyoutTitle?.[lang]}
      >
        <p>{page.buyoutBody?.[lang]}</p>
      </EditorialSplit>
    </div>
  </section>

  <section class="section section--tortora">
    <div class="container container--narrow">
      <p style="max-width: 62ch;">{page.honest?.[lang]}</p>
      <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: var(--space-3);">
        <a class="btn btn--solid" href={p(lang, 'contact')}>{page.cta?.[lang]}</a>
        <a class="btn" href={egumaUrl('events', lang)} rel="noopener">Tickets & events</a>
      </div>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'events') },
    ])}
  />
</Base>
