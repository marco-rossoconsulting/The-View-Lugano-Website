---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, dict, p, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { byCategory } from '../../lib/photos';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const t = dict(lang);
const fleet = byCategory('fleet')[0];
---

<Base {lang} title={t.sustainability.metaTitle} description={t.sustainability.metaDesc} route="sustainability">
  <Breadcrumbs {lang} crumbs={[{ label: t.nav.sustainability }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{t.sustainability.h1}</h1>
      <p class="page-intro">{t.sustainability.intro}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container sust">
      <div class="sust__photo fade-up">
        <Pic src={fleet.src} alt={fleet.alt[lang]} width={1600} height={1067} sizes="(max-width: 900px) 100vw, 58vw" />
      </div>
      <div class="sust__body fade-up">
        <p>{t.sustainability.body1}</p>
        <p>{t.sustainability.body2}</p>
        <p>{t.sustainability.body3}</p>
      </div>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: t.nav.home, url: p(lang) },
      { name: t.nav.sustainability, url: p(lang, 'sustainability') },
    ])}
  />
</Base>

<style>
  .sust {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: start;
  }
  .sust__photo :global(img) { width: 100%; height: auto; display: block; }
  .sust__body p { margin-bottom: 1rem; }
  @media (max-width: 900px) { .sust { grid-template-columns: 1fr; } }
</style>
