---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { byCategory } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const pageEntries = await getCollection('pages');
const page = pageEntries.find((e) => e.data.slug === 'sustainability')?.data;
if (!page) throw new Error('Missing sustainability CMS content');

const fleet = byCategory('fleet')[0];
---

<Base {lang} title={page.metaTitle[lang]} description={page.metaDesc[lang]} route="sustainability">
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro">{page.intro[lang]}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container sust">
      <div class="sust__photo fade-up">
        <Pic src={fleet.src} alt={fleet.alt[lang]} width={1600} height={1067} sizes="(max-width: 900px) 100vw, 58vw" />
      </div>
      <div class="sust__body fade-up">
        {page.body?.[lang]?.map((pText: string) => <p>{pText}</p>)}
      </div>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'sustainability') },
    ])}
  />
</Base>

<style>
  .sust {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: start;
  }
  .sust__photo :global(img) { width: 100%; height: auto; display: block; }
  .sust__body p { margin-bottom: 1rem; }
  @media (max-width: 900px) { .sust { grid-template-columns: 1fr; } }
</style>
