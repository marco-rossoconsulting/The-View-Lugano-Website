---
import Base from '../../../layouts/Base.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { LOCALES, p, isLocale, type Locale } from '../../../lib/i18n';
import { breadcrumbJsonLd } from '../../../lib/seo';
import { getCollection } from 'astro:content';

const PAGES = ['impressum', 'privacy', 'terms', 'cookies'] as const;
type LegalPage = (typeof PAGES)[number];

export function getStaticPaths() {
  const P = ['impressum', 'privacy', 'terms', 'cookies'];
  return LOCALES.flatMap((lang) => P.map((page) => ({ params: { lang, page } })));
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);
const pageSlug = Astro.params.page as LegalPage;

const [legalEntries, settingsEntries] = await Promise.all([
  getCollection('legal'),
  getCollection('settings'),
]);

const legalPage = legalEntries.find((e) => e.data.slug === pageSlug)?.data;
const settings = settingsEntries[0]?.data;
if (!legalPage || !settings) throw new Error('Missing legal CMS content');

const navLabel = settings.nav[pageSlug]?.[lang] ?? pageSlug;
---

<Base
  {lang}
  title={`${legalPage.title[lang]} — THE VIEW Lugano`}
  description={legalPage.body[lang][0]}
  route={`legal/${pageSlug}`}
>
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow">{settings.nav.legal?.[lang]}</p>
      <h1 class="page-title">{legalPage.title[lang]}</h1>
      <div class="legal-body">
        {legalPage.body[lang].map((par: string) => <p>{par}</p>)}
      </div>
      {pageSlug === 'cookies' && (
        <button type="button" class="btn" data-open-consent style="margin-top: var(--space-3);">
          {settings.nav.cookies?.[lang]}
        </button>
      )}
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: settings.nav.home?.[lang], url: p(lang) },
      { name: navLabel, url: p(lang, 'legal', pageSlug) },
    ])}
  />
</Base>

<style>
  .legal-body p {
    margin-bottom: 1.1rem;
    max-width: 68ch;
    font-size: 0.96rem;
  }
</style>
