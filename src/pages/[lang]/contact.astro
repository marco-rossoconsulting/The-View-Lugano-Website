---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd, localBusinessJsonLd } from '../../lib/seo';
import { SITE } from '../../lib/site';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const pageEntries = await getCollection('pages');
const page = pageEntries.find((entry) => entry.data.slug === 'contact')?.data;
const contactEntries = await getCollection('contact');
const contact = contactEntries[0]?.data;

if (!page) throw new Error('Missing contact SEO content');
if (!contact) throw new Error('Missing contact CMS content');

const whatsappUrl = `https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}?${new URLSearchParams({
  text: contact.reach.whatsappMessage[lang],
}).toString()}`;
const mapCoordinates = `${SITE.geo.lat},${SITE.geo.lng}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapCoordinates)}`;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapCoordinates)}&z=16&output=embed`;
---

<Base
  {lang}
  title={page.metaTitle[lang]}
  description={page.metaDesc[lang]}
  route="contact"
>
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section section--tortora contact-request">
    <div class="container contact-request__inner">
      <div class="contact-request__form fade-up">
        <h1>{page.h1[lang]}</h1>
        <p class="contact-request__lede">{page.intro[lang]}</p>
        <h2 class="contact-request__title">{contact.form.title[lang]}</h2>
        <p class="contact-request__intro">{contact.form.body[lang]}</p>

        <form
          class="contact-form"
          name="contact"
          method="POST"
          action={p(lang, 'contact')}
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-contact-form
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="language" value={lang} />
          <p class="contact-form__honeypot" aria-hidden="true">
            <label>Do not fill this out if you are human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="contact-form__grid">
            <div class="contact-form__field">
              <label for="contact-name">{contact.form.nameLabel[lang]}</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="contact-form__field">
              <label for="contact-email">{contact.form.emailLabel[lang]}</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="contact-form__field contact-form__field--full">
              <label for="contact-topic">{contact.form.topicLabel[lang]}</label>
              <select id="contact-topic" name="topic" required>
                <option value="" disabled selected>{contact.form.topicPlaceholder[lang]}</option>
                {contact.form.topics.map((topic) => <option value={topic.value}>{topic.label[lang]}</option>)}
              </select>
            </div>
            <div class="contact-form__field contact-form__field--full">
              <label for="contact-message">{contact.form.messageLabel[lang]}</label>
              <textarea id="contact-message" name="message" rows="5" required></textarea>
            </div>
          </div>

          <div class="contact-form__footer">
            <p>{contact.form.privacy[lang]}</p>
            <button class="btn btn--solid" type="submit" data-contact-form-submit>{contact.form.submit[lang]}</button>
          </div>
        </form>

        <output class="contact-form__status" aria-live="polite" hidden data-contact-form-status>
          <span data-contact-form-success>{contact.form.success[lang]}</span>
          <span hidden data-contact-form-error>{contact.form.error[lang]}</span>
        </output>
      </div>

      <aside class="contact-reach fade-up" aria-labelledby="contact-reach-title">
        <p class="eyebrow">{contact.reach.eyebrow[lang]}</p>
        <h2 id="contact-reach-title">{contact.reach.title[lang]}</h2>
        <p>{contact.reach.body[lang]}</p>

        <address class="contact-reach__list">
          <div class="contact-reach__item">
            <p>{contact.reach.addressLabel[lang]}</p>
            <span>{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.locality}<br />{SITE.address.countryName}</span>
          </div>
          <div class="contact-reach__item">
            <p>{contact.reach.phoneLabel[lang]}</p>
            <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
          </div>
          <div class="contact-reach__item">
            <p>{contact.reach.whatsappLabel[lang]}</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{SITE.whatsapp}</a>
          </div>
          <div class="contact-reach__item">
            <p>{contact.reach.emailLabel[lang]}</p>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </div>
          <div class="contact-reach__item">
            <p>{contact.reach.salesEmailLabel[lang]}</p>
            <a href={`mailto:${contact.reach.salesEmail}`}>{contact.reach.salesEmail}</a>
          </div>
        </address>
      </aside>
    </div>
  </section>

  <section class="section contact-map">
    <div class="container contact-map__inner">
      <div class="contact-map__copy fade-up">
        <h2>{contact.map.title[lang]}</h2>
        <p>{contact.map.body[lang]}</p>
        <a class="btn" href={directionsUrl} target="_blank" rel="noopener noreferrer">{contact.map.directions[lang]}</a>
      </div>
      <div class="contact-map__frame fade-up">
        <iframe
          src={mapEmbedUrl}
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${SITE.name}, ${SITE.address.locality}`}
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section section--densa contact-professional">
    <div class="container contact-professional__inner">
      <article class="contact-professional__item fade-up">
        <h2>{contact.trade.title[lang]}</h2>
        <p>{contact.trade.body[lang]}</p>
        <p class="contact-professional__note">{contact.trade.gdsNote[lang]}</p>
        <ul class="facts contact-professional__gds">
          <li>Amadeus: {SITE.gds.amadeus}</li>
          <li>Sabre: {SITE.gds.sabre}</li>
          <li>Galileo / Apollo: {SITE.gds.galileo}</li>
          <li>WorldSpan: {SITE.gds.worldspan}</li>
        </ul>
        <a class="text-link contact-professional__email" href={`mailto:${contact.reach.salesEmail}`}>{contact.reach.salesEmail}</a>
      </article>
      <article class="contact-professional__item contact-professional__item--careers fade-up">
        <h2>{contact.careers.title[lang]}</h2>
        <p>{contact.careers.body[lang]}</p>
        <a class="text-link contact-professional__email" href={`mailto:${contact.careers.email}`}>{contact.careers.email}</a>
      </article>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'contact') },
    ])}
  />
  <JsonLd data={localBusinessJsonLd(lang)} />
</Base>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLOutputElement>('[data-contact-form-status]');
    const success = status?.querySelector<HTMLElement>('[data-contact-form-success]');
    const error = status?.querySelector<HTMLElement>('[data-contact-form-error]');
    const submit = form.querySelector<HTMLButtonElement>('[data-contact-form-submit]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const body = new URLSearchParams();
      data.forEach((value, key) => {
        if (typeof value === 'string') body.append(key, value);
      });

      if (submit) submit.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        if (!response.ok) throw new Error('Contact form request failed');

        form.hidden = true;
        if (status) status.hidden = false;
        if (success) success.hidden = false;
        if (error) error.hidden = true;
      } catch {
        if (status) status.hidden = false;
        if (success) success.hidden = true;
        if (error) error.hidden = false;
        if (submit) submit.disabled = false;
      }
    });
  });
</script>

<style>
  .contact-request__inner,
  .contact-map__inner,
  .contact-professional__inner {
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .contact-request__form {
    grid-column: 1 / span 7;
  }

  .contact-request {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .contact-request__form h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.8rem);
    margin-bottom: var(--space-2);
  }

  .contact-request__form h2,
  .contact-reach h2,
  .contact-map h2,
  .contact-professional h2 {
    font-size: clamp(1.65rem, 3vw, 2.6rem);
    max-width: 13ch;
  }

  .contact-request__intro {
    margin-bottom: var(--space-3);
    max-width: 46ch;
  }

  .contact-request__lede {
    font-size: clamp(1.03rem, 1.35vw, 1.18rem);
    line-height: 1.68;
    margin-bottom: var(--space-3);
    max-width: 34ch;
  }

  .contact-request__title {
    margin-bottom: var(--space-2);
  }

  .contact-form {
    border-top: 1px solid var(--tortora-densa);
    padding-top: var(--space-3);
  }

  .contact-form__grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .contact-form__field {
    display: grid;
    gap: 0.45rem;
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form label {
    color: var(--clay);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    background: var(--ground);
    border: 1px solid var(--tortora-densa);
    border-radius: 0;
    color: var(--ink);
    font: inherit;
    min-height: 3rem;
    padding: 0.72rem 0.9rem;
    width: 100%;
  }

  .contact-form textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--clay);
    outline: 2px solid color-mix(in srgb, var(--clay) 35%, transparent);
    outline-offset: 2px;
  }

  .contact-form__honeypot {
    height: 0;
    margin: 0;
    overflow: hidden;
    position: absolute;
    width: 0;
  }

  .contact-form__footer {
    align-items: center;
    display: flex;
    gap: var(--space-2);
    justify-content: space-between;
    margin-top: var(--space-3);
  }

  .contact-form__footer p {
    color: var(--clay);
    font-size: 0.78rem;
    line-height: 1.55;
    margin: 0;
    max-width: 47ch;
  }

  .contact-form__footer .btn {
    flex: 0 0 auto;
  }

  .contact-form__status {
    background: var(--ground);
    border-left: 2px solid var(--clay);
    margin-top: var(--space-3);
    max-width: 52ch;
    padding: 1rem 1.2rem;
  }

  .contact-reach {
    align-self: start;
    border-left: 1px solid var(--tortora-densa);
    grid-column: 9 / -1;
    padding-left: clamp(1.5rem, 4vw, 4rem);
  }

  .contact-reach__list {
    font-style: normal;
    margin-top: var(--space-3);
  }

  .contact-reach__item {
    border-top: 1px solid var(--tortora-densa);
    display: grid;
    gap: 0.8rem;
    grid-template-columns: minmax(6.5rem, 0.7fr) 1.3fr;
    padding-block: 1.1rem;
  }

  .contact-reach__item:last-child {
    border-bottom: 1px solid var(--tortora-densa);
  }

  .contact-reach__item p {
    color: var(--clay);
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.19em;
    margin: 0;
    text-transform: uppercase;
  }

  .contact-reach__item a {
    border-bottom: 1px solid transparent;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
    transition: border-color 220ms ease, color 220ms ease;
  }

  .contact-reach__item a:hover,
  .contact-reach__item a:focus-visible {
    border-color: var(--clay);
    color: var(--clay);
  }

  .contact-map__inner {
    align-items: center;
  }

  .contact-map__copy {
    grid-column: 1 / span 4;
  }

  .contact-map__copy .btn {
    margin-top: var(--space-2);
  }

  .contact-map__frame {
    grid-column: 6 / -1;
    min-height: 28rem;
    overflow: hidden;
  }

  .contact-map__frame iframe {
    border: 0;
    display: block;
    filter: saturate(0.82) contrast(1.03);
    height: 100%;
    min-height: 28rem;
    width: 100%;
  }

  .contact-professional__item {
    grid-column: 1 / span 5;
  }

  .contact-professional__item--careers {
    border-left: 1px solid var(--tortora-densa);
    grid-column: 7 / -1;
    padding-left: clamp(1.5rem, 5vw, 5rem);
  }

  .contact-professional__note {
    color: var(--clay);
    font-size: 0.9rem;
    margin-top: var(--space-3);
  }

  .contact-professional__gds {
    margin-bottom: var(--space-3);
  }

  .contact-professional__gds li {
    font-variant-numeric: tabular-nums;
  }

  .text-link {
    border-bottom: 1px solid var(--clay);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: border-color 220ms ease, color 220ms ease;
  }

  .text-link:hover,
  .text-link:focus-visible {
    border-color: var(--ink);
    color: var(--clay);
  }

  .contact-professional__email {
    letter-spacing: 0.04em;
    text-transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-reach__item a,
    .text-link {
      transition: none;
    }
  }

  @media (max-width: 820px) {
    .contact-request__inner,
    .contact-map__inner,
    .contact-professional__inner {
      display: block;
    }

    .contact-reach,
    .contact-professional__item--careers {
      border-left: 0;
      border-top: 1px solid var(--tortora-densa);
      margin-top: var(--space-4);
      padding: var(--space-4) 0 0;
    }

    .contact-map__copy {
      margin-bottom: var(--space-4);
    }

    .contact-map__frame,
    .contact-map__frame iframe {
      min-height: min(100vw, 31rem);
    }
  }

  @media (max-width: 560px) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }

    .contact-form__field--full {
      grid-column: auto;
    }

    .contact-form__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .contact-form__footer .btn {
      width: 100%;
    }

    .contact-reach__item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
