---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import Waterline from '../../components/Waterline.astro';
import Faq from '../../components/Faq.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { hotelJsonLd } from '../../lib/seo';
import { find } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const [homeEntries, settingsEntries] = await Promise.all([
  getCollection('homepage'),
  getCollection('settings'),
]);

const home = homeEntries[0]?.data;
const settings = settingsEntries[0]?.data;
if (!home || !settings) throw new Error('Missing CMS content');

const hero = find(home.hero.image);
---

<Base
  {lang}
  title={home.hero.line[lang]}
  description={home.hero.tagline[lang]}
  route=""
  preloadImage={hero.src}
  overlayHeader
>
  <Hero src={hero.src} video="/hero-video.mp4" alt={hero.alt[lang]} line={home.hero.line[lang]} tagline={home.hero.tagline[lang]} h1 />

  {home.sections.map((sec) => {
    const img = find(sec.image);
    return (
      <section class={`section${sec.id === 'ambassador' || sec.id === 'spa' ? ' section--tortora' : ''}`}>
        <div class="container">
          <EditorialSplit
            src={img.src}
            alt={img.alt[lang]}
            eyebrow={sec.eyebrow?.[lang]}
            title={sec.title[lang]}
            flip={sec.flip}
            cta={{ href: p(lang, sec.ctaHref.replace(/^\/|\/$/g, '')), label: sec.ctaLabel[lang] }}
          >
            {sec.body[lang].map((pText: string) => <p>{pText}</p>)}
          </EditorialSplit>
        </div>
      </section>
    );
  })}

  <div class="container"><Waterline /></div>

  <section class="section">
    <div class="container container--narrow fade-up">
      <p class="eyebrow">{home.trust.eyebrow[lang]}</p>
      <h2 class="trust-title">{home.trust.title[lang]}</h2>
      <div class="trust">
        {home.trust.items.map((item) => <p>{item.text[lang]}</p>)}
      </div>
    </div>
  </section>

  <Faq {lang} />
  <JsonLd data={hotelJsonLd(lang)} />
</Base>

<style>
  .trust-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    margin-bottom: var(--space-3);
    text-wrap: balance;
  }
  .trust {
    display: grid;
    gap: 1.25rem;
    max-width: 62ch;
  }
</style>
