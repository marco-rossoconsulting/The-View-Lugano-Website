---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import AmbassadorTeam from '../../components/AmbassadorTeam.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ExperienceAccordion from '../../components/ExperienceAccordion.astro';
import Quote from '../../components/Quote.astro';
import ScrollExpand from '../../components/ScrollExpand.astro';
import FedAndRestored from '../../components/FedAndRestored.astro';
import Faq from '../../components/Faq.astro';
import AwardsLogoLoop from '../../components/AwardsLogoLoop.astro';
import JsonLd from '../../components/JsonLd.astro';
import juniorSuiteImage from '../../assets/images/home/the-view-lugano-junior-suite.jpg';
import { localePaths, p, isLocale, dict, type Locale } from '../../lib/i18n';
import { hotelJsonLd } from '../../lib/seo';
import { find } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);
const t = dict(lang);

const [homeEntries, settingsEntries] = await Promise.all([
  getCollection('homepage'),
  getCollection('settings'),
]);

const home = homeEntries[0]?.data;
const settings = settingsEntries[0]?.data;
if (!home || !settings) throw new Error('Missing CMS content');

const hero = find(home.hero.image);
const heroVideoPoster = '/images/hero-video-poster.webp';
const section = (id: string) => home.sections.find((s) => s.id === id)!;
const intro = section('intro');
const ambassador = section('ambassador');
const dining = section('dining');
const spa = section('spa');
const days = home.days;
const dayDestinations: Record<string, string> = {
  explore: 'experiences',
  relax: 'spa',
  taste: 'dining',
  move: 'spa',
  gather: 'events',
};
const editorialCta = (sec: typeof intro) => ({
  href: p(lang, sec.ctaHref.replace(/^\/|\/$/g, '')),
  label: sec.ctaLabel[lang],
});

const theHouseImage = {
  src: juniorSuiteImage,
  alt: {
    en: 'Junior Suite at THE VIEW Lugano with a private terrace and panoramic view of Lake Lugano',
    de: 'Junior Suite im THE VIEW Lugano mit privater Terrasse und Panoramablick auf den Luganersee',
    it: 'Junior Suite al THE VIEW Lugano con terrazza privata e vista panoramica sul Lago di Lugano',
    fr: 'Junior Suite au THE VIEW Lugano avec terrasse privée et vue panoramique sur le lac de Lugano',
  } satisfies Record<Locale, string>,
};
