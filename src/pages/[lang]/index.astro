---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import StatBand from '../../components/StatBand.astro';
import CinematicBreak from '../../components/CinematicBreak.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import Quote from '../../components/Quote.astro';
import BookingBar from '../../components/BookingBar.astro';
import Waterline from '../../components/Waterline.astro';
import Faq from '../../components/Faq.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, dict, type Locale } from '../../lib/i18n';
import { hotelJsonLd } from '../../lib/seo';
import { find } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const [homeEntries, settingsEntries] = await Promise.all([
  getCollection('homepage'),
  getCollection('settings'),
]);

const home = homeEntries[0]?.data;
const settings = settingsEntries[0]?.data;
if (!home || !settings) throw new Error('Missing CMS content');

const hero = find(home.hero.image);
const cinematic = find(home.cinematic.image);
const t = dict(lang);
const section = (id: string) => home.sections.find((s) => s.id === id)!;
const intro = section('intro');
const ambassador = section('ambassador');
const dining = section('dining');
const spa = section('spa');
const fleet = section('fleet');
const editorialCta = (sec: typeof intro) => ({
  href: p(lang, sec.ctaHref.replace(/^\/|\/$/g, '')),
  label: sec.ctaLabel[lang],
});
---

<Base
  {lang}
  title={home.hero.line[lang]}
  description={home.hero.tagline[lang]}
  route=""
  preloadImage={hero.src}
  overlayHeader
>
  <Hero src={hero.src} video="/hero-video.mp4" alt={hero.alt[lang]} line={home.hero.line[lang]} tagline={home.hero.tagline[lang]} h1 />

  <section class="section">
    <div class="container">
      <EditorialSplit
        src={find(intro.image).src}
        alt={find(intro.image).alt[lang]}
        eyebrow={intro.eyebrow?.[lang]}
        title={intro.title[lang]}
        flip={intro.flip}
        cta={editorialCta(intro)}
      >
        {intro.body[lang].map((pText: string) => <p>{pText}</p>)}
      </EditorialSplit>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <StatBand items={home.stats.map((s) => ({ value: s.value, label: s.label[lang] }))} />
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <EditorialSplit
        src={find(ambassador.image).src}
        alt={find(ambassador.image).alt[lang]}
        eyebrow={ambassador.eyebrow?.[lang]}
        title={ambassador.title[lang]}
        flip={ambassador.flip}
        cta={editorialCta(ambassador)}
      >
        {ambassador.body[lang].map((pText: string) => <p>{pText}</p>)}
      </EditorialSplit>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EditorialSplit
        src={find(dining.image).src}
        alt={find(dining.image).alt[lang]}
        eyebrow={dining.eyebrow?.[lang]}
        title={dining.title[lang]}
        flip={dining.flip}
        cta={editorialCta(dining)}
      >
        {dining.body[lang].map((pText: string) => <p>{pText}</p>)}
      </EditorialSplit>
    </div>
  </section>

  <CinematicBreak src={cinematic.src} alt={cinematic.alt[lang]} caption={home.cinematic.caption[lang]} />

  <section class="section section--tortora">
    <div class="container">
      <EditorialSplit
        src={find(spa.image).src}
        alt={find(spa.image).alt[lang]}
        eyebrow={spa.eyebrow?.[lang]}
        title={spa.title[lang]}
        flip={spa.flip}
        cta={editorialCta(spa)}
      >
        {spa.body[lang].map((pText: string) => <p>{pText}</p>)}
      </EditorialSplit>
    </div>
  </section>

  <TrustBadges {lang} />

  <section class="section">
    <div class="container">
      <EditorialSplit
        src={find(fleet.image).src}
        alt={find(fleet.image).alt[lang]}
        eyebrow={fleet.eyebrow?.[lang]}
        title={fleet.title[lang]}
        flip={fleet.flip}
        cta={editorialCta(fleet)}
      >
        {fleet.body[lang].map((pText: string) => <p>{pText}</p>)}
      </EditorialSplit>
    </div>
  </section>

  <div class="container"><Waterline /></div>

  <section class="section">
    <div class="container">
      <Quote
        eyebrow={home.trust.eyebrow[lang]}
        title={home.trust.title[lang]}
        quotes={home.trust.items.map((item) => item.text[lang])}
      />
    </div>
  </section>

  <section class="section section--tortora">
    <div class="container reserve">
      <p class="eyebrow">{t.common.checkAvailability}</p>
      <BookingBar {lang} />
    </div>
  </section>

  <Faq {lang} />
  <JsonLd data={hotelJsonLd(lang)} />
</Base>

<style>
  .reserve {
    max-width: 52rem;
  }
</style>
