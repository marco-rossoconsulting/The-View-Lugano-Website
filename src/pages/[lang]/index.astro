---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ExperienceAccordion from '../../components/ExperienceAccordion.astro';
import Quote from '../../components/Quote.astro';
import ScrollExpand from '../../components/ScrollExpand.astro';
import FedAndRestored from '../../components/FedAndRestored.astro';
import Waterline from '../../components/Waterline.astro';
import Faq from '../../components/Faq.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { hotelJsonLd } from '../../lib/seo';
import { find } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const [homeEntries, settingsEntries] = await Promise.all([
  getCollection('homepage'),
  getCollection('settings'),
]);

const home = homeEntries[0]?.data;
const settings = settingsEntries[0]?.data;
if (!home || !settings) throw new Error('Missing CMS content');

const hero = find(home.hero.image);
const section = (id: string) => home.sections.find((s) => s.id === id)!;
const intro = section('intro');
const ambassador = section('ambassador');
const dining = section('dining');
const spa = section('spa');
const days = home.days;
const dayDestinations: Record<string, string> = {
  explore: 'experiences',
  relax: 'spa',
  taste: 'dining',
  move: 'spa',
  gather: 'events',
};
const editorialCta = (sec: typeof intro) => ({
  href: p(lang, sec.ctaHref.replace(/^\/|\/$/g, '')),
  label: sec.ctaLabel[lang],
});

// Localised guest testimonials.
const guestQuotes: Record<Locale, string[]> = {
  en: [
    "The hotel's intimate size created an ambiance of exclusivity, making us feel like cherished guests rather than just visitors.",
    'A wonderful blend of luxury, comfort, and serenity.',
  ],
  de: [
    'Die intime Größe des Hotels schuf eine Atmosphäre der Exklusivität, in der wir uns wie geschätzte Gäste und nicht einfach wie Besucher fühlten.',
    'Eine wunderbare Verbindung aus Luxus, Komfort und Ruhe.',
  ],
  it: [
    "Le dimensioni intime dell'hotel hanno creato un'atmosfera di esclusività, facendoci sentire ospiti preziosi e non semplici visitatori.",
    'Un meraviglioso connubio di lusso, comfort e serenità.',
  ],
  fr: [
    "La taille intime de l'hôtel a créé une atmosphère d'exclusivité, nous faisant sentir comme des hôtes précieux plutôt que de simples visiteurs.",
    'Un merveilleux équilibre de luxe, de confort et de sérénité.',
  ],
};

const memoryReveal: Record<Locale, { compactTitle: string; expandedTitle: string; alt: string }> = {
  en: {
    compactTitle: 'some things you see',
    expandedTitle: "some things you feel, and remember long after you've left.",
    alt: 'Lugano and the lake seen through a window at golden hour',
  },
  de: {
    compactTitle: 'manches sieht man',
    expandedTitle: 'manches spürt man, und erinnert sich noch lange daran, nachdem man gegangen ist.',
    alt: 'Lugano und der See im Abendlicht, durch ein Fenster gesehen',
  },
  it: {
    compactTitle: 'alcune cose si vedono',
    expandedTitle: 'alcune cose si percepiscono, e restano nella memoria molto tempo dopo la partenza.',
    alt: 'Lugano e il lago al tramonto, visti attraverso una finestra',
  },
  fr: {
    compactTitle: 'certaines choses se voient',
    expandedTitle: 'certaines choses se ressentent, et restent en mémoire longtemps après votre départ.',
    alt: 'Lugano et le lac à l’heure dorée, vus à travers une fenêtre',
  },
};

const fedAndRestored: Record<Locale, { title: string; subtitle: string; diningAlt: string; spaAlt: string }> = {
  en: {
    title: 'Fed and Restored',
    subtitle: 'Two rituals shape every stay here - one at the table, one in stillness.',
    diningAlt: 'A plated course from THE VIEW Fine Dining',
    spaAlt: 'A massage treatment at THE VIEW SPA',
  },
  de: {
    title: 'Genährt und erneuert',
    subtitle: 'Zwei Rituale prägen jeden Aufenthalt hier: eines am Tisch, eines in der Stille.',
    diningAlt: 'Ein angerichteter Gang aus dem THE VIEW Fine Dining',
    spaAlt: 'Eine Massagebehandlung im THE VIEW SPA',
  },
  it: {
    title: 'Nutriti e rigenerati',
    subtitle: 'Due rituali danno forma a ogni soggiorno qui: uno a tavola, uno nella quiete.',
    diningAlt: 'Una portata impiattata di THE VIEW Fine Dining',
    spaAlt: 'Un trattamento di massaggio alla THE VIEW SPA',
  },
  fr: {
    title: 'Nourri et ressourcé',
    subtitle: "Deux rituels façonnent chaque séjour ici : l'un à table, l'autre dans le calme.",
    diningAlt: 'Un plat dressé de THE VIEW Fine Dining',
    spaAlt: 'Un soin de massage au THE VIEW SPA',
  },
};
---

<Base
  {lang}
  title={home.hero.line[lang]}
  description={home.hero.tagline[lang]}
  route=""
  preloadImage={hero.src}
  overlayHeader
>
  <Hero src={hero.src} video="/hero-video.mp4" alt={hero.alt[lang]} line={home.hero.line[lang]} tagline={home.hero.tagline[lang]} h1 />

  {/* The House */}
  <section class="section">
    <div class="container">
      <EditorialSplit
        src={find(intro.image).src}
        alt={find(intro.image).alt[lang]}
        eyebrow={intro.eyebrow?.[lang]}
        title={intro.title[lang]}
        flip={intro.flip}
        cta={editorialCta(intro)}
      >
        {intro.body[lang].map((pText: string) => <p>{pText}</p>)}
      </EditorialSplit>
    </div>
  </section>

  <section class="section section--tortora days-section">
    <div class="container">
      <div class="days-section__header">
        <div class="days-section__header-copy">
          <SectionHeader eyebrow={days.eyebrow[lang]} title={days.title[lang]} />
        </div>
      </div>
      <ExperienceAccordion
        ariaLabel={days.eyebrow[lang]}
        defaultIndex={2}
        items={days.items.map((item) => {
          const photo = find(item.image);
          return {
            src: photo.src,
            alt: photo.alt[lang],
            title: item.title[lang],
            body: item.body[lang],
            href: p(lang, dayDestinations[item.id]),
          };
        })}
      />
    </div>
  </section>

  {/* The Ambassador */}
  <section class="section section--ink">
    <div class="container">
      <EditorialSplit
        src={find(ambassador.image).src}
        alt={find(ambassador.image).alt[lang]}
        eyebrow={ambassador.eyebrow?.[lang]}
        title={ambassador.title[lang]}
        flip={ambassador.flip}
        cta={editorialCta(ambassador)}
      >
        {ambassador.body[lang].map((pText: string) => <p>{pText}</p>)}
      </EditorialSplit>
    </div>
  </section>

  <FedAndRestored
    title={fedAndRestored[lang].title}
    subtitle={fedAndRestored[lang].subtitle}
    dining={{
      eyebrow: dining.eyebrow?.[lang],
      title: dining.title[lang],
      body: dining.body[lang],
      cta: editorialCta(dining),
      alt: fedAndRestored[lang].diningAlt,
    }}
    spa={{
      eyebrow: spa.eyebrow?.[lang],
      title: spa.title[lang],
      body: spa.body[lang],
      cta: editorialCta(spa),
      alt: fedAndRestored[lang].spaAlt,
    }}
  />

  <ScrollExpand {...memoryReveal[lang]} />

  <section class="section section--tortora guest-quote-section">
    <div class="container">
      <Quote quotes={guestQuotes[lang]} />
    </div>
  </section>

  <div class="container"><Waterline /></div>

  <Faq {lang} />
  <JsonLd data={hotelJsonLd(lang)} />
</Base>

<style>
  .guest-quote-section {
    padding-block: clamp(4rem, 7vw, 5.5rem);
  }

  .days-section__header {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    margin-bottom: clamp(3rem, 4.5vw, 4.5rem);
  }

  .days-section__header-copy {
    grid-column: 1;
  }

  @media (max-width: 900px) {
    .days-section__header {
      grid-template-columns: 1fr;
    }

    .days-section__header-copy {
      grid-column: 1;
    }
  }

</style>
