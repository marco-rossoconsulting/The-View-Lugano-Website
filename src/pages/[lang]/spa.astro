---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import Hero from '../../components/Hero.astro';
import Pic from '../../components/Pic.astro';
import SkewedCarousel from '../../components/SkewedCarousel.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd, spaJsonLd } from '../../lib/seo';
import { SITE, egumaUrl } from '../../lib/site';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';

import goldLeafFacial from '../../assets/images/spa/spa-gold-leaf-facial-treatment.jpg';
import spaIntroPool from '../../assets/images/spa/spa-intro-indoor-pool.jpg';
import nightSpaPool from '../../assets/images/spa/night-spa-pool-violet-light.jpg';
import nightSpaLounger from '../../assets/images/spa/night-spa-candlelit-lounger.jpg';
import nightSpaCascade from '../../assets/images/spa/night-spa-cascade-jet.jpg';

// Carousel photography, 3:4 crops. Keys match `gallery.items[].key` in the
// spa-experience entry, which carries the localised titles and alt text.
import entranceCorridor from '../../assets/images/spa/spa-entrance-corridor.jpg';
import relaxationLounge from '../../assets/images/spa/spa-relaxation-lounge.jpg';
import himalayanSaltRoom from '../../assets/images/spa/spa-himalayan-salt-relaxation-room.jpg';
import saltRoomLoungers from '../../assets/images/spa/spa-salt-room-loungers.jpg';
import saunaCedarCabin from '../../assets/images/spa/spa-sauna-cedar-cabin.jpg';
import wetAreaChromotherapy from '../../assets/images/spa/spa-wet-area-chromotherapy.jpg';
import emotionalShower from '../../assets/images/spa/spa-emotional-shower.jpg';
import hydrotherapyBath from '../../assets/images/spa/spa-hydrotherapy-bath.jpg';
import treatmentRoomTable from '../../assets/images/spa/spa-treatment-room-massage-table.jpg';
import treatmentRoomDetails from '../../assets/images/spa/spa-treatment-room-details.jpg';
import indoorPool from '../../assets/images/spa/spa-indoor-pool.jpg';
import vitalityPool from '../../assets/images/spa/spa-vitality-pool.jpg';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const [pageEntries, spaExpEntries, treatmentEntries] = await Promise.all([
  getCollection('pages'),
  getCollection('spaExperience'),
  getCollection('spa'),
]);

const page = pageEntries.find((e) => e.data.slug === 'spa-index')?.data;
const spaExp = spaExpEntries[0]?.data;
if (!page) throw new Error('Missing spa-index CMS content');
if (!spaExp) throw new Error('Missing spa-experience CMS content');

const treatments = treatmentEntries
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);

const treatmentBySlug = new Map(treatmentEntries.map((e) => [e.id.replace(/\.json$/, ''), e.data]));

function localizedVariant(duration: string): string {
  const labels = spaExp.variantLabels as unknown as Record<string, Record<Locale, string>>;
  return labels[duration]?.[lang] ?? duration;
}

const currentMonth = new Date().getMonth() + 1;
const monthFeature =
  spaExp.treatmentOfMonth.months.find((m) => m.month === currentMonth) ??
  spaExp.treatmentOfMonth.months[0];
const featuredTreatment = treatmentBySlug.get(monthFeature.treatmentSlug);

const GALLERY_IMAGES: Record<string, ImageMetadata> = {
  entranceCorridor,
  relaxationLounge,
  himalayanSaltRoom,
  saltRoomLoungers,
  saunaCedarCabin,
  wetAreaChromotherapy,
  emotionalShower,
  hydrotherapyBath,
  treatmentRoomTable,
  treatmentRoomDetails,
  indoorPool,
  vitalityPool,
};

const galleryItems = spaExp.gallery.items.map((item) => {
  const src = GALLERY_IMAGES[item.key];
  if (!src) throw new Error(`Missing spa gallery image for key "${item.key}"`);
  return { src, title: item.title[lang], alt: item.alt[lang] };
});

const alts: Record<string, Record<Locale, string>> = {
  spaIntroPool: {
    en: 'The indoor pool at THE VIEW SPA, reflected beneath the sculpted ceiling',
    de: 'Der Innenpool im THE VIEW SPA, unter der skulpturalen Decke gespiegelt',
    it: 'La piscina interna di THE VIEW SPA, riflessa sotto il soffitto scolpito',
    fr: 'La piscine intérieure du THE VIEW SPA, reflétée sous le plafond sculpté',
  },
  goldLeafFacial: {
    en: '24-karat gold leaf applied during a facial treatment',
    de: '24-karätiges Blattgold während einer Gesichtsbehandlung',
    it: "Foglia d'oro a 24 carati applicata durante un trattamento viso",
    fr: "Feuille d'or 24 carats appliquée pendant un soin du visage",
  },
  nightSpaPool: {
    en: 'The indoor pool after dark, the sculpted ceiling and the water lit violet',
    de: 'Der Innenpool nach Einbruch der Dunkelheit, die geschwungene Decke und das Wasser violett beleuchtet',
    it: 'La piscina interna dopo il tramonto, il soffitto scolpito e l’acqua illuminati di viola',
    fr: 'La piscine intérieure à la nuit tombée, le plafond sculpté et l’eau éclairés de violet',
  },
  nightSpaLounger: {
    en: 'A lounger dressed with candles and rose petals at the water’s edge during Night Spa',
    de: 'Eine Liege mit Kerzen und Rosenblättern am Wasserrand während des Night Spa',
    it: 'Un lettino con candele e petali di rosa a bordo vasca durante il Night Spa',
    fr: 'Un transat garni de bougies et de pétales de rose au bord de l’eau pendant le Night Spa',
  },
  nightSpaCascade: {
    en: 'The cascade jet falling into the pool under violet light',
    de: 'Die Schwalldusche fällt unter violettem Licht in den Pool',
    it: 'Il getto a cascata che cade nella piscina sotto la luce viola',
    fr: 'Le jet en cascade tombant dans la piscine sous une lumière violette',
  },
};

const spaBookingUrl = SITE.integrations.spaBooking;
const spaGiftUrl = egumaUrl('spaVouchers', lang);
const contactUrl = p(lang, 'contact');
---

<Base
  {lang}
  title={page.metaTitle[lang]}
  description={page.metaDesc[lang]}
  route="spa"
  overlayHeader
  ogImage="https://d1vp8nomjxwyf1.cloudfront.net/wp-content/uploads/sites/456/2018/07/12135345/hotel_012.jpg"
  preloadImage="/images/spa-hero-video-poster.jpg"
>
  <Hero
    src="/images/spa-hero-video-poster.jpg"
    video="/spa-hero-video.mp4"
    poster="/images/spa-hero-video-poster.jpg"
    alt={spaExp.hero.alt[lang]}
    line={page.h1[lang]}
    tagline={spaExp.hero.tagline[lang]}
    h1
  />

  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section spa-intro">
    <div class="container spa-intro__layout">
      <div class="spa-intro__copy">
        <p class="page-intro fade-up">{page.intro[lang]}</p>
        <p class="page-note fade-up">{spaExp.philosophy[lang]}</p>
        <div class="spa-cta-row fade-up">
          <a class="btn btn--solid" href={spaBookingUrl} target="_blank" rel="noopener noreferrer">
            {spaExp.booking.bookLabel[lang]}
          </a>
          <a class="btn" href={spaGiftUrl} target="_blank" rel="noopener noreferrer">
            {spaExp.booking.giftLabel[lang]}
          </a>
        </div>
        <p class="spa-hours fade-up">
          <span>{spaExp.hours.openLabel[lang]} {SITE.spa.hours}</span>
          <span aria-hidden="true">·</span>
          <span>{spaExp.hours.treatmentsLabel[lang]} {SITE.spa.treatmentHours}</span>
        </p>
        <nav class="spa-jump-links fade-up" aria-label={spaExp.navigation.label[lang]}>
          <a href="#night-spa">{spaExp.navigation.nightSpa[lang]}</a>
          <a href="#spa-access">{spaExp.navigation.access[lang]}</a>
        </nav>
      </div>
      <div class="spa-intro__media fade-up">
        <Pic
          src={spaIntroPool}
          alt={alts.spaIntroPool[lang]}
          width={2400}
          height={1601}
          widths={[480, 720, 960, 1200, 1600]}
          sizes="(max-width: 720px) 100vw, 34vw"
        />
      </div>
    </div>
  </section>

  <section class="section section--tortora spa-menu">
    <div class="container container--narrow">
      <h2 class="section-title fade-up">{spaExp.treatments.title[lang]}</h2>
      <p class="spa-menu__intro fade-up">{spaExp.treatments.intro[lang]}</p>

      {featuredTreatment && (
        <aside class="spa-highlight fade-up">
          <div class="spa-highlight__photo">
            <Pic
              src={goldLeafFacial}
              alt={alts.goldLeafFacial[lang]}
              width={2000}
              height={1334}
              widths={[320, 480, 640]}
              sizes="(max-width: 640px) 100vw, 13rem"
            />
          </div>
          <div class="spa-highlight__copy">
            <p class="eyebrow">{spaExp.treatmentOfMonth.eyebrow[lang]}</p>
            <h3>{featuredTreatment.name[lang]}</h3>
            <p class="spa-highlight__note">{monthFeature.note[lang]}</p>
            <p class="spa-highlight__price">
              {featuredTreatment.variants.map((v) => `${localizedVariant(v.duration)} · ${v.price}`).join(' / ')}
            </p>
            <a class="text-link" href={spaBookingUrl} target="_blank" rel="noopener noreferrer">
              {spaExp.treatmentOfMonth.ctaLabel[lang]}
            </a>
          </div>
        </aside>
      )}

      <div class="spa-categories">
        {spaExp.treatments.categories.map((cat) => {
          const catTreatments = treatments.filter((t) => t.category === cat.id);
          return (
            // All categories start closed; the guest chooses what to open.
            <details class="spa-category fade-up">
              <summary class="spa-category__summary">
                <span>{cat.title[lang]}</span>
                <span class="spa-category__count">{catTreatments.length}</span>
              </summary>
              <div class="spa-category__body">
                <p class="spa-category__intro">{cat.intro[lang]}</p>
                {cat.note && <p class="spa-category__note">{cat.note[lang]}</p>}
                <ul class="treatments">
                  {catTreatments.map((tr) => (
                    <li class="treatment">
                      <div class="treatment__head">
                        <h3>{tr.name[lang]}</h3>
                        <span class="treatment__price">
                          {tr.variants.map((v) => `${localizedVariant(v.duration)} · ${v.price}`).join(' / ')}
                        </span>
                      </div>
                      <p>{tr.summary[lang]}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          );
        })}
      </div>

      <a class="btn" href={spaBookingUrl} target="_blank" rel="noopener noreferrer">
        {spaExp.treatments.bookLabel[lang]}
      </a>
    </div>
  </section>

  <section class="section spa-gallery">
    <div class="container">
      <h2 class="section-title fade-up">{spaExp.gallery.title[lang]}</h2>
      <p class="spa-gallery__intro fade-up">{spaExp.gallery.intro[lang]}</p>
    </div>
    <div class="fade-up">
      <SkewedCarousel
        items={galleryItems}
        ariaLabel={spaExp.gallery.title[lang]}
        prevLabel={spaExp.gallery.prevLabel[lang]}
        nextLabel={spaExp.gallery.nextLabel[lang]}
        goToLabel={spaExp.gallery.goToLabel[lang]}
        initialIndex={2}
      />
    </div>
  </section>

  <section id="night-spa" class="section section--ink spa-night">
    <div class="container">
      <p class="eyebrow fade-up">{spaExp.nightSpa.eyebrow[lang]}</p>
      <h2 class="fade-up">{spaExp.nightSpa.title[lang]}</h2>
      <p class="spa-night__body fade-up">{spaExp.nightSpa.body[lang]}</p>
      <p class="spa-night__access fade-up">{spaExp.nightSpa.accessNote[lang]}</p>
      <div class="spa-night__private fade-up">
        <span>{spaExp.nightSpa.privateAccess.label[lang]}</span>
        <strong>{spaExp.nightSpa.privateAccess.time[lang]}</strong>
        <p>{spaExp.nightSpa.privateAccess.body[lang]}</p>
      </div>
      <div class="spa-night__experience">
        <div class="spa-night__grid fade-up">
          <div class="spa-night__main">
            <Pic src={nightSpaPool} alt={alts.nightSpaPool[lang]} width={1800} height={1200} sizes="(max-width: 720px) 100vw, 62vw" />
          </div>
          <div class="spa-night__side">
            <Pic src={nightSpaLounger} alt={alts.nightSpaLounger[lang]} width={1200} height={900} sizes="(max-width: 720px) 50vw, 30vw" />
            <Pic src={nightSpaCascade} alt={alts.nightSpaCascade[lang]} width={1200} height={1600} sizes="(max-width: 720px) 50vw, 30vw" />
          </div>
        </div>
        <aside class="spa-night__pricing fade-up" aria-labelledby="night-spa-pricing">
          <h3 id="night-spa-pricing">{spaExp.nightSpa.pricingTitle[lang]}</h3>
          <dl class="spa-price-list">
            {spaExp.nightSpa.prices.map((item) => (
              <div>
                <dt>{item.label[lang]}</dt>
                <dd>{item.price[lang]}</dd>
                {item.note && <p>{item.note[lang]}</p>}
              </div>
            ))}
          </dl>
          <a class="btn btn--light" href={contactUrl}>{spaExp.nightSpa.ctaLabel[lang]}</a>
        </aside>
      </div>
    </div>
  </section>

  <section id="spa-access" class="section spa-access">
    <div class="container container--narrow">
      <h2 class="section-title fade-up">{spaExp.salesCategories.title[lang]}</h2>
      <p class="spa-access__intro fade-up">{spaExp.salesCategories.intro[lang]}</p>
      <div class="spa-access__grid">
        {spaExp.salesCategories.items.map((item) => (
          <article class="spa-access__card fade-up">
            <h3>{item.title[lang]}</h3>
            <p>{item.body[lang]}</p>
            <dl class="spa-price-list spa-price-list--light">
              {item.prices.map((price) => (
                <div>
                  <dt>{price.label[lang]}</dt>
                  <dd>{price.price[lang]}</dd>
                  {price.note && <p>{price.note[lang]}</p>}
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
      <a class="btn" href={contactUrl}>{spaExp.salesCategories.ctaLabel[lang]}</a>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'spa') },
    ])}
  />
  <JsonLd data={spaJsonLd(lang, 'https://d1vp8nomjxwyf1.cloudfront.net/wp-content/uploads/sites/456/2018/07/12135345/hotel_012.jpg')} />
</Base>

<style>
  .section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    margin-bottom: var(--space-2);
  }

  .spa-intro {
    padding-bottom: var(--space-4);
  }
  .spa-intro__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5.75rem);
  }
  .spa-intro__copy {
    min-width: 0;
  }
  .spa-intro__media {
    overflow: hidden;
  }
  .spa-intro__media :global(picture),
  .spa-intro__media :global(img) {
    display: block;
  }
  .spa-intro__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .page-intro {
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.7;
    max-width: 52ch;
  }
  .page-note {
    color: var(--clay);
    max-width: 56ch;
  }
  .spa-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--space-3);
  }
  /* Practical times sit with the booking buttons, where someone about to
     reserve is already looking. */
  .spa-hours {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: var(--space-2) 0 0;
    max-width: none;
    color: var(--clay);
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .spa-hours span[aria-hidden] {
    opacity: 0.55;
  }
  .spa-jump-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    margin-top: var(--space-2);
  }
  .spa-jump-links a {
    border-bottom: 1px solid var(--clay);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: border-color 220ms ease, color 220ms ease;
  }
  .spa-jump-links a:hover,
  .spa-jump-links a:focus-visible {
    border-color: var(--ink);
    color: var(--clay);
  }
  @media (max-width: 460px) {
    .spa-hours span[aria-hidden] {
      display: none;
    }
    .spa-hours {
      flex-direction: column;
      gap: 0.3rem;
    }
  }
  @media (max-width: 720px) {
    .spa-intro__layout {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  /* Treatment of the month — a quiet lead-in to the menu, not a section of
     its own. The full description lives in the accordion below. */
  .spa-highlight {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
    align-items: center;
    margin-bottom: var(--space-4);
    padding: clamp(0.9rem, 2vw, 1.25rem);
    background: var(--ground);
    border: 1px solid var(--tortora-densa);
  }
  .spa-highlight__photo {
    flex: 0 0 auto;
    width: clamp(5.5rem, 16vw, 9rem);
  }
  .spa-highlight__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .spa-highlight__copy {
    min-width: 0;
  }
  .spa-highlight__copy .eyebrow {
    margin-bottom: 0.35rem;
  }
  .spa-highlight__copy h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    letter-spacing: 0.02em;
    margin: 0 0 0.3rem;
  }
  .spa-highlight__note {
    color: var(--clay);
    font-size: 0.95rem;
    margin: 0 0 0.3rem;
    max-width: 46ch;
  }
  .spa-highlight__price {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clay);
    margin: 0 0 0.7rem;
  }
  .text-link {
    display: inline-block;
    border-bottom: 1px solid var(--clay);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: border-color 220ms ease, color 220ms ease;
  }
  .text-link:hover,
  .text-link:focus-visible {
    border-color: var(--ink);
    color: var(--clay);
  }
  @media (max-width: 560px) {
    .spa-highlight {
      flex-direction: column;
      align-items: flex-start;
    }
    .spa-highlight__photo {
      width: 100%;
    }
    .spa-highlight__photo :global(img) {
      aspect-ratio: 16 / 9;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .text-link {
      transition: none;
    }
  }

  /* Treatment menu accordion */
  .spa-menu__intro {
    max-width: 58ch;
    margin-bottom: var(--space-3);
  }
  .spa-categories {
    display: grid;
    gap: 0;
    margin-bottom: var(--space-3);
    border-top: 1px solid var(--tortora-densa);
  }
  .spa-category {
    border-bottom: 1px solid var(--tortora-densa);
  }
  .spa-category__summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.2rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    letter-spacing: 0.02em;
  }
  .spa-category__summary::-webkit-details-marker {
    display: none;
  }
  .spa-category__summary::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--clay);
    flex-shrink: 0;
    order: -1;
    margin-right: 0.5rem;
  }
  .spa-category[open] .spa-category__summary::after {
    content: '–';
  }
  .spa-category__count {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--clay);
    margin-right: auto;
    margin-left: 0.75rem;
  }
  .spa-category__body {
    padding-bottom: var(--space-3);
  }
  .spa-category__intro {
    max-width: 58ch;
    margin-bottom: 0.5rem;
  }
  .spa-category__note {
    max-width: 58ch;
    color: var(--clay);
    font-size: 0.92rem;
    margin-bottom: var(--space-2);
  }
  .treatments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .treatment {
    border-top: 1px solid var(--tortora-densa);
    padding-top: var(--space-2);
  }
  .treatment__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 0.4rem;
  }
  .treatment__head h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    margin: 0;
  }
  .treatment__price {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clay);
    white-space: nowrap;
  }
  .treatment p {
    max-width: 60ch;
    margin: 0;
  }

  /* Gallery — the carousel owns its own layout; the section only sets the
     copy above it and lets the cards run to the full page width. */
  .spa-gallery__intro {
    max-width: 58ch;
    margin-bottom: var(--space-4);
  }

  /* Night spa */
  .spa-night {
    scroll-margin-top: 7rem;
  }
  .spa-night__body {
    max-width: 62ch;
    color: var(--tortora);
  }
  .spa-night__access {
    max-width: 62ch;
    color: var(--grigio);
    font-size: 0.92rem;
