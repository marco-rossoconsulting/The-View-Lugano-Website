---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { egumaUrl } from '../../lib/site';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const [pageEntries, offerEntries] = await Promise.all([
  getCollection('pages'),
  getCollection('offers'),
]);

const page = pageEntries.find((e) => e.data.slug === 'experiences')?.data;
const offers = offerEntries.sort((a, b) => a.data.order - b.data.order);
if (!page) throw new Error('Missing experiences CMS content');
---

<Base {lang} title={page.metaTitle[lang]} description={page.metaDesc[lang]} route="experiences">
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro">{page.intro[lang]}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container offers">
      {offers.map((o, i) => (
        <article class={`editorial fade-up${i % 2 ? ' editorial--flip' : ''}`}>
          <div class="editorial__photo">
            <Pic
              src={o.data.photo.src}
              alt={o.data.photo.alt[lang]}
              width={1600}
              height={1067}
              sizes="(max-width: 900px) 100vw, 58vw"
            />
          </div>
          <div class="editorial__text">
            <h2 class="offer-name">{o.data.name[lang]}</h2>
            {o.data.body[lang].map((par: string) => <p>{par}</p>)}
            <ul class="facts">
              {o.data.includes.map((inc) => <li>{inc[lang]}</li>)}
            </ul>
            <a class="btn" href={p(lang, 'contact')}>{page.cta?.[lang]}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--tortora">
    <div class="container container--narrow">
      <h2 class="offer-name">{page.voucherTitle?.[lang]}</h2>
      <p style="max-width: 60ch; margin-bottom: var(--space-2);">{page.voucherBody?.[lang]}</p>
      <a class="btn" href={egumaUrl('vouchers', lang)} rel="noopener">Vouchers</a>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'experiences') },
    ])}
  />
</Base>

<style>
  .offers { display: grid; gap: var(--space-5); }
  .editorial {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  .editorial--flip { grid-template-columns: 4fr 7fr; }
  .editorial--flip .editorial__photo { order: 2; }
  .editorial--flip .editorial__text { order: 1; }
  .editorial__photo :global(img) { width: 100%; height: auto; display: block; }
  .offer-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    margin-bottom: var(--space-2);
  }
  .editorial__text p { margin-bottom: 1rem; }
  .editorial__text .facts { margin-block: var(--space-2); }
  @media (max-width: 900px) {
    .editorial, .editorial--flip { grid-template-columns: 1fr; }
    .editorial--flip .editorial__photo { order: 1; }
    .editorial--flip .editorial__text { order: 2; }
  }
</style>
