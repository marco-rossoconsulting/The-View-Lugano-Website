---
import Base from '../../layouts/Base.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TheForkWidget from '../../components/TheForkWidget.astro';
import JsonLd from '../../components/JsonLd.astro';
import Waterline from '../../components/Waterline.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const [pageEntries, venueEntries] = await Promise.all([
  getCollection('pages'),
  getCollection('dining'),
]);

const page = pageEntries.find((e) => e.data.slug === 'dining-index')?.data;
const venues = venueEntries.sort((a, b) => a.data.order - b.data.order);
const restaurant = venues.find((v) => v.data.kind === 'restaurant')!;
const terrace = venues.find((v) => v.data.kind === 'terrace')!;
const bar = venues.find((v) => v.data.kind === 'bar')!;
if (!page) throw new Error('Missing dining-index CMS content');
---

<Base {lang} title={page.metaTitle[lang]} description={page.metaDesc[lang]} route="dining" ogImage={restaurant.data.photos[0].src}>
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro">{page.intro[lang]}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <EditorialSplit
        src={restaurant.data.photos[0].src}
        alt={restaurant.data.photos[0].alt[lang]}
        title={page.restaurantTitle?.[lang]}
      >
        {page.restaurantBody?.[lang]?.map((par: string) => <p>{par}</p>)}
        <ul class="facts facts--inline">
          {restaurant.data.facts.map((f) => <li>{f[lang]}</li>)}
        </ul>
      </EditorialSplit>
    </div>
  </section>

  <section class="section section--tortora">
    <div class="container">
      <EditorialSplit
        src={terrace.data.photos[0].src}
        alt={terrace.data.photos[0].alt[lang]}
        title={page.terraceTitle?.[lang]}
        flip
      >
        <p>{page.terraceBody?.[lang]}</p>
      </EditorialSplit>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EditorialSplit
        src={bar.data.photos[0].src}
        alt={bar.data.photos[0].alt[lang]}
        title={page.barTitle?.[lang]}
      >
        <p>{page.barBody?.[lang]}</p>
      </EditorialSplit>
    </div>
  </section>

  <section class="section section--tortora">
    <div class="container container--narrow">
      <h2 class="section-title">{page.breakfastTitle?.[lang]}</h2>
      <p style="max-width: 62ch;">{page.breakfastBody?.[lang]}</p>
    </div>
  </section>

  <div class="container"><Waterline /></div>

  <section class="section">
    <div class="container container--narrow">
      <h2 class="section-title">{page.reserveTable?.[lang]}</h2>
      <TheForkWidget {lang} />
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'dining') },
    ])}
  />
</Base>

<style>
  .facts--inline { margin-top: var(--space-2); }
  .section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    margin-bottom: var(--space-2);
  }
</style>
