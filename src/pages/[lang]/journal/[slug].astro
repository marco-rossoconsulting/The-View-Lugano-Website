---
import Base from '../../../layouts/Base.astro';
import Pic from '../../../components/Pic.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { LOCALES, dict, p, type Locale } from '../../../lib/i18n';
import { breadcrumbJsonLd } from '../../../lib/seo';
import { SITE } from '../../../lib/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return LOCALES.flatMap((lang) =>
    posts.map((post) => ({ params: { lang, slug: post.id }, props: { post } }))
  );
}

const lang = Astro.params.lang as Locale;
const { post } = Astro.props;
const t = dict(lang);
const d = post.data;
const fmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : `${lang}-CH`, { dateStyle: 'long' });
---

<Base
  {lang}
  title={`${d.title[lang]} — THE VIEW Lugano Journal`}
  description={d.excerpt[lang]}
  route={`journal/${post.id}`}
  ogImage={d.photo.src}
>
  <article>
    <section class="section">
      <div class="container container--narrow">
        <p class="eyebrow">{t.nav.journal} · {fmt.format(new Date(d.date))}</p>
        <h1 class="page-title">{d.title[lang]}</h1>
      </div>
    </section>

    <section class="section" style="padding-top:0;">
      <div class="container container--narrow">
        <Pic src={d.photo.src} alt={d.photo.alt[lang]} width={1600} height={1067} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" />
      </div>
    </section>

    <section class="section" style="padding-top:0;">
      <div class="container container--narrow article-body">
        {d.body[lang].map((par: string) => <p>{par}</p>)}
        <a class="btn" href={p(lang, 'journal')} style="margin-top: var(--space-3);">{t.common.backTo} {t.nav.journal}</a>
      </div>
    </section>
  </article>

  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: d.title[lang],
      description: d.excerpt[lang],
      image: d.photo.src,
      datePublished: d.date,
      inLanguage: lang,
      author: { '@type': 'Organization', name: SITE.name },
      publisher: { '@type': 'Organization', name: SITE.name },
      mainEntityOfPage: `${SITE.url}${p(lang, 'journal', post.id)}`,
    }}
  />
  <JsonLd
    data={breadcrumbJsonLd([
      { name: t.nav.home, url: p(lang) },
      { name: t.nav.journal, url: p(lang, 'journal') },
      { name: d.title[lang], url: p(lang, 'journal', post.id) },
    ])}
  />
</Base>

<style>
  .article-body p {
    margin-bottom: 1.2rem;
    max-width: 62ch;
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .article-body :global(img) { width: 100%; height: auto; }
</style>
