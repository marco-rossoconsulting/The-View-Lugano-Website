---
import Base from '../../../layouts/Base.astro';
import Pic from '../../../components/Pic.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { localePaths, p, isLocale, type Locale } from '../../../lib/i18n';
import { breadcrumbJsonLd } from '../../../lib/seo';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const [pageEntries, journalEntries] = await Promise.all([
  getCollection('pages'),
  getCollection('journal'),
]);

const page = pageEntries.find((e) => e.data.slug === 'journal-index')?.data;
const posts = journalEntries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
if (!page) throw new Error('Missing journal-index CMS content');
---

<Base {lang} title={page.metaTitle[lang]} description={page.metaDesc[lang]} route="journal">
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro">{page.intro[lang]}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container journal-grid">
      {posts.map((post) => (
        <article class="journal-card fade-up">
          <a href={p(lang, 'journal', post.id)}>
            <Pic
              src={post.data.photo.src}
              alt={post.data.photo.alt[lang]}
              width={1200}
              height={800}
              sizes="(max-width: 900px) 100vw, 50vw"
            />
          </a>
          <div class="journal-card__text">
            <p class="journal-card__date">{post.data.date}</p>
            <h2 class="journal-card__title">
              <a href={p(lang, 'journal', post.id)}>{post.data.title[lang]}</a>
            </h2>
            <p class="journal-card__excerpt">{post.data.excerpt[lang]}</p>
            <a class="link-arrow" href={p(lang, 'journal', post.id)}>{page.readingTime?.[lang]}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'journal') },
    ])}
  />
</Base>

<style>
  .journal-grid {
    display: grid;
    gap: var(--space-5);
  }
  .journal-card {
    display: grid;
    grid-template-columns: 5fr 4fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .journal-card:nth-child(even) { grid-template-columns: 4fr 5fr; }
  .journal-card:nth-child(even) a:first-child { order: 2; }
  .journal-card:nth-child(even) .journal-card__text { order: 1; }
  .journal-card :global(img) { width: 100%; height: auto; display: block; }
  .journal-card__date {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 0.5rem;
  }
  .journal-card__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin-bottom: var(--space-1);
  }
  .journal-card__title a { border: 0; }
  .journal-card__excerpt {
    color: var(--clay);
    margin-bottom: var(--space-2);
    max-width: 52ch;
  }
  .link-arrow {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .journal-card, .journal-card:nth-child(even) { grid-template-columns: 1fr; }
    .journal-card:nth-child(even) a:first-child { order: 1; }
    .journal-card:nth-child(even) .journal-card__text { order: 2; }
  }
</style>
