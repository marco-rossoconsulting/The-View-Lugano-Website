---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import Hero from '../../components/Hero.astro';
import StatBand from '../../components/StatBand.astro';
import Pic from '../../components/Pic.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd, localBusinessJsonLd, howToArriveJsonLd } from '../../lib/seo';
import { SITE } from '../../lib/site';
import { find, byCategory } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const pageEntries = await getCollection('pages');
const page = pageEntries.find((e) => e.data.slug === 'location')?.data;
if (!page) throw new Error('Missing location CMS content');
if (!page.arrivalStats?.length) throw new Error('Missing location arrivalStats');

// NOTE: photos.ts mislabels several entries in the hotel_0XX sequence (their
// captions don't match the actual file at that CDN path — confirmed against
// the source images directly, not a caching issue). hotel_061 is genuinely
// the terrace/lake view this hero needs; its manifest caption ("The entrance
// drive at dusk") is one of the wrong ones, so the alt text is overridden
// here rather than trusted from the manifest. Flagged for a separate
// manifest cleanup — out of scope for this page.
const hero = find('hotel_061');
const heroAlt: Record<Locale, string> = {
  en: 'The terrace at THE VIEW, looking down toward Lugano and the lake',
  de: 'Die Terrasse im THE VIEW mit Blick auf Lugano und den See',
  it: 'La terrazza del THE VIEW, con vista su Lugano e il lago',
  fr: 'La terrasse du THE VIEW, avec vue sur Lugano et le lac',
};
const fleet = byCategory('fleet');
const smartCar = fleet.find((f) => f.src.includes('smart')) ?? fleet[0];
const ebike = fleet.find((f) => f.src.includes('bici')) ?? fleet[1] ?? fleet[0];

const statItems = page.arrivalStats.map((s) => ({
  value: s.value,
  unit: s.unit[lang],
  label: s.label[lang],
  detail: s.detail[lang],
}));

const fleetCaptions: Record<Locale, { car: string; bike: string }> = {
  en: { car: 'Electric Smart car', bike: 'E-bike' },
  de: { car: 'Elektrischer Smart', bike: 'E-Bike' },
  it: { car: 'Smart elettrica', bike: 'E-bike' },
  fr: { car: 'Smart électrique', bike: 'Vélo électrique' },
};

const mapCoordinates = `${SITE.geo.lat},${SITE.geo.lng}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapCoordinates)}`;
// Keyless embed (no Maps API key needed), same pattern as the contact page.
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapCoordinates)}&z=15&output=embed`;
---

<Base
  {lang}
  title={page.metaTitle[lang]}
  description={page.metaDesc[lang]}
  route="location"
  overlayHeader
  ogImage={hero.src}
  preloadImage={hero.src}
>
  <Hero
    src={hero.src}
    alt={heroAlt[lang]}
    line={page.h1[lang]}
    tagline={page.heroTagline?.[lang]}
    h1
  />

  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section location-intro">
    <div class="container container--narrow">
      <p class="page-intro fade-up">{page.intro[lang]}</p>
      <p class="page-note fade-up">
        {SITE.name} · {SITE.address.street}, {SITE.address.postalCode} {SITE.address.locality}, {SITE.address.countryName}
      </p>
    </div>
  </section>

  <section class="section section--tortora location-stats">
    <div class="container">
      <h2 class="section-title fade-up">{page.arrivingTitle?.[lang]}</h2>
      <StatBand items={statItems} />
      {page.arrivalNote?.[lang] && <p class="location-stats__note fade-up">{page.arrivalNote[lang]}</p>}
    </div>
  </section>

  <section class="section location-map">
    <div class="container">
      <div class="location-map__grid fade-up">
        <div class="location-map__copy">
          <h2>{SITE.address.locality}</h2>
          <address>
            {SITE.address.street}<br />
            {SITE.address.postalCode} {SITE.address.locality}<br />
            {SITE.address.countryName}
          </address>
          <a class="btn" href={directionsUrl} target="_blank" rel="noopener noreferrer">
            {page.directionsLabel?.[lang]}
          </a>
        </div>
        <div class="location-map__frame">
          <iframe
            src={mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`${SITE.name} — ${SITE.address.locality}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section location-fleet">
    <div class="container location-fleet__grid">
      <div class="location-fleet__photos fade-up">
        <figure class="location-fleet__photo location-fleet__photo--car">
          <Pic
            src={smartCar.src}
            alt={smartCar.alt[lang]}
            width={smartCar.width}
            height={smartCar.height}
            sizes="(max-width: 720px) 62vw, 24vw"
          />
          <figcaption>{fleetCaptions[lang].car}</figcaption>
        </figure>
        <figure class="location-fleet__photo location-fleet__photo--bike">
          <Pic
            src={ebike.src}
            alt={ebike.alt[lang]}
            width={ebike.width}
            height={ebike.height}
            sizes="(max-width: 720px) 62vw, 24vw"
          />
          <figcaption>{fleetCaptions[lang].bike}</figcaption>
        </figure>
      </div>
      <div class="location-fleet__copy fade-up">
        <h2>{page.aroundTitle?.[lang]}</h2>
        <p>{page.aroundBody?.[lang]}</p>
      </div>
    </div>
  </section>

  <section class="section location-around">
    <div class="container container--narrow">
      <h2 class="section-title fade-up">{page.luganoTitle?.[lang]}</h2>
      <p class="fade-up" style="max-width: 62ch;">{page.luganoBody?.[lang]}</p>
    </div>
  </section>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'location') },
    ])}
  />
  <JsonLd data={localBusinessJsonLd(lang)} />
  <JsonLd data={howToArriveJsonLd(lang)} />
</Base>

<style>
  .section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    margin-bottom: var(--space-3);
  }

  .location-intro .page-note {
    color: var(--clay);
  }

  /* Stats */
  .location-stats__note {
    max-width: 62ch;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--tortora-densa);
    color: var(--clay);
    font-size: 0.95rem;
  }

  /* Map: address + hairline-framed embed, asymmetric like the rest of the
     page's editorial grid, but with no photograph competing for attention. */
  .location-map__grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: stretch;
  }
  .location-map__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .location-map__copy h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    margin-bottom: var(--space-2);
  }
  .location-map__copy address {
    font-style: normal;
    color: var(--clay);
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }
  .location-map__copy .btn {
    align-self: flex-start;
  }
  .location-map__frame {
    min-height: 24rem;
    border: 1px solid var(--tortora-densa);
    overflow: hidden;
    background: var(--tortora);
  }
  .location-map__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 24rem;
    filter: saturate(0.85) contrast(1.02);
  }
  @media (max-width: 820px) {
    .location-map__grid {
      grid-template-columns: 1fr;
    }
    .location-map__frame,
    .location-map__frame iframe {
      min-height: min(90vw, 22rem);
    }
  }

  /* Moving around: two real photographs (car + e-bike) instead of the
     single image the rest of the site's editorial split uses, so both get
     equal weight rather than one standing in for the pair. */
  .location-fleet__grid {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  .location-fleet__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.6rem, 1.4vw, 1.1rem);
  }
  .location-fleet__photo {
    margin: 0;
  }
  .location-fleet__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .location-fleet__photo--bike {
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }
  .location-fleet__photo figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .location-fleet__copy h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    margin-bottom: var(--space-2);
  }
  @media (max-width: 900px) {
    .location-fleet__grid {
      grid-template-columns: 1fr;
    }
    .location-fleet__copy {
      order: -1;
    }
    .location-fleet__photo--bike {
      margin-top: clamp(2rem, 10vw, 3rem);
    }
  }
</style>
