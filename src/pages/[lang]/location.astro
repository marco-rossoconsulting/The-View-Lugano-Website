---
import Base from '../../layouts/Base.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import Waterline from '../../components/Waterline.astro';
import { localePaths, p, isLocale, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd, localBusinessJsonLd, howToArriveJsonLd } from '../../lib/seo';
import { SITE } from '../../lib/site';
import { find, byCategory } from '../../lib/photos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale ${lang}`);

const pageEntries = await getCollection('pages');
const page = pageEntries.find((e) => e.data.slug === 'location')?.data;
if (!page) throw new Error('Missing location CMS content');

const hero = find('hotel_041');
const fleet = byCategory('fleet');
---

<Base {lang} title={page.metaTitle[lang]} description={page.metaDesc[lang]} route="location">
  <Breadcrumbs {lang} crumbs={[{ label: page.h1[lang] }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1 class="page-title">{page.h1[lang]}</h1>
      <p class="page-intro">{page.intro[lang]}</p>
      <p class="page-note">
        {SITE.name} · {SITE.address.street}, {SITE.address.postalCode} {SITE.address.locality}, {SITE.address.countryName}
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="map-embed">
        <iframe
          src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2771.0!2d${SITE.geo.lng}!3d${SITE.geo.lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDXCsDU5JzA5LjEiTiA4wrA1NiczOS43IkU!5e0!3m2!1sen!2s${lang}!4v1`}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${SITE.name} — ${SITE.address.locality}`}
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EditorialSplit src={hero.src} alt={hero.alt[lang]} title={page.arrivingTitle?.[lang]}>
        <p>{page.byCar?.[lang]}</p>
        <p>{page.byTrain?.[lang]}</p>
        <p>{page.byAir?.[lang]}</p>
      </EditorialSplit>
    </div>
  </section>

  <section class="section section--tortora">
    <div class="container">
      <EditorialSplit
        src={fleet[1] ? fleet[1].src : fleet[0].src}
        alt={fleet[1] ? fleet[1].alt[lang] : fleet[0].alt[lang]}
        title={page.aroundTitle?.[lang]}
        flip
      >
        <p>{page.aroundBody?.[lang]}</p>
      </EditorialSplit>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <h2 class="section-title">{page.luganoTitle?.[lang]}</h2>
      <p style="max-width: 62ch;">{page.luganoBody?.[lang]}</p>
    </div>
  </section>

  <div class="container"><Waterline /></div>

  <JsonLd
    data={breadcrumbJsonLd([
      { name: 'Home', url: p(lang) },
      { name: page.h1[lang], url: p(lang, 'location') },
    ])}
  />
  <JsonLd data={localBusinessJsonLd(lang)} />
  <JsonLd data={howToArriveJsonLd(lang)} />
</Base>

<style>
  .section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    margin-bottom: var(--space-2);
  }
  .map-embed {
    border: 1px solid var(--tortora-densa);
    overflow: hidden;
    background: var(--tortora);
  }
  .map-embed iframe {
    display: block;
    width: 100%;
    height: 450px;
    filter: saturate(0.85) contrast(1.02);
  }
</style>
